{
  "schema_version": 1,
  "repo_id": "agentops",
  "authority_repo_uuid": "1308d624-3413-4327-a891-9d9cdfc2d4ea",
  "adoption_level": "guidance-only",
  "routing": {
    "default_harness": "codex",
    "default_model_alias": "fast-build",
    "action_classes": {
      "plan": { "enabled": true, "model_alias": "frontier-plan" },
      "build": { "enabled": true, "model_alias": "fast-build", "review_required": true },
      "review": { "enabled": true, "model_alias": "review-synthesis" },
      "verify": { "enabled": true, "model_alias": "review-synthesis", "review_required": true },
      "reconcile": { "enabled": true, "model_alias": "review-synthesis" }
    }
  },
  "skills": {
    "template_root": "/projects/dev/agentops/templates/dispatch/skills",
    "selected": [
      "dispatch-plan",
      "dispatch-build",
      "dispatch-review",
      "code-change-verification",
      "item-done",
      "model-routing-optimizer",
      "workflow-artifact-capture",
      "reconcile-project-contracts"
    ]
  },
  "scope": {
    "allowed_path_roots": [
      "apps/",
      "templates/",
      "docs/",
      ".agents/",
      ".claude/",
      ".project/",
      "AGENTS.md",
      "agentops.toml",
      "project.toml"
    ],
    "out_of_scope": [
      "runtime behavior owned by sprintctl, kctl, actionq, or actionq-dispatcher",
      "cluster reconciliation, image publication, or deployment mutation"
    ]
  },
  "hybrid": {
    "enabled": true,
    "worker_routes": ["bulk"],
    "commands": {
      "agentops.dispatch.tests": "python -m unittest discover -s templates/dispatch/tests",
      "agentops.hybrid.validate": "python templates/dispatch/scripts/validate_hybrid_dispatch.py --agentops-root . --manifest agentops.dispatch.json"
    },
    "protected_paths": [
      "templates/dispatch/hybrid/**",
      "templates/dispatch/model-routing.json",
      "templates/dispatch/manifest.schema.json",
      "templates/dispatch/scripts/hybrid_dispatch.py",
      "agentops.dispatch.json",
      ".claude/**"
    ],
    "worktree_root": "/tmp/agentops-hybrid/worktrees",
    "max_timeout_seconds": 1800,
    "max_cost_usd": 3.0,
    "notes": [
      "The dispatch contract itself is coordinator-only: a worker must never edit the policy, schema, or driver that bounds it."
    ]
  },
  "verification": {
    "command_families": ["unit", "docs", "full-suite"],
    "targeted_first": true,
    "commands": [
      "python -m unittest discover -s templates/dispatch/tests",
      "npm --prefix apps/web test",
      "npm --prefix apps/web run build"
    ]
  },
  "hooks": {
    "level": "verification",
    "publishers": ["git", "dispatcher-gate"]
  }
}
