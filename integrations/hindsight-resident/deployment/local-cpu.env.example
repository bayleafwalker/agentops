# Complete alternative to the downstream service.env.example, not an overlay.
# Template only. Replace REPLACE_* values through the protected host deployment.
# Never load this from a model-writable working directory.
HINDSIGHT_API_DATABASE_URL=REPLACE_WITH_PROTECTED_POSTGRES_DSN
HINDSIGHT_API_DATABASE_SCHEMA=public
HINDSIGHT_API_VECTOR_EXTENSION=pgvector
HINDSIGHT_API_TEXT_SEARCH_EXTENSION=native
HINDSIGHT_API_RUN_MIGRATIONS_ON_STARTUP=false

HINDSIGHT_API_TENANT_EXTENSION=hindsight_ext_resident:ResidentTenantExtension
HINDSIGHT_API_TENANT_POLICY_FILE=/etc/resident-memory/policy.json
HINDSIGHT_API_OPERATION_VALIDATOR_EXTENSION=hindsight_ext_resident:ResidentOperationValidator
HINDSIGHT_API_OPERATION_VALIDATOR_POLICY_FILE=/etc/resident-memory/policy.json

# A separately granted memory gateway holds the workstation credential.
# The native resident's loopback gateway is not implicitly accessible here.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=https://REPLACE_WITH_MEMORY_GATEWAY.invalid/v1
HINDSIGHT_API_LLM_MODEL=worker-fast
HINDSIGHT_API_LLM_API_KEY=REPLACE_WITH_MEMORY_GATEWAY_ONLY_CREDENTIAL
HINDSIGHT_API_LLM_REQUEST_EXTENSION=hindsight_ext_bank_llm_routing:BankLLMRoutingExtension
HINDSIGHT_API_LLM_REQUEST_ROUTES=[{"bank":"resident-story","schema":"public","provider":"openai","model":"worker-fast"}]
HINDSIGHT_API_LLM_REQUEST_UNMATCHED=deny
HINDSIGHT_API_SKIP_LLM_VERIFICATION=true
HINDSIGHT_API_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_LLM_MAX_RETRIES=0
HINDSIGHT_API_LLM_TIMEOUT=900
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=8192
HINDSIGHT_API_CONSOLIDATION_MAX_COMPLETION_TOKENS=8192
HINDSIGHT_API_REFLECT_MAX_COMPLETION_TOKENS=8192

# Immutable artifact prepared from embedding-artifact.json; no runtime download.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=/opt/resident-models/bge-small-en-v1.5/5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
HINDSIGHT_API_EMBEDDINGS_LOCAL_FORCE_CPU=true
HINDSIGHT_API_EMBEDDINGS_LOCAL_TRUST_REMOTE_CODE=false
HINDSIGHT_API_EMBEDDINGS_LOCAL_MAX_CONCURRENT=1
HINDSIGHT_API_RERANKER_PROVIDER=rrf
HINDSIGHT_API_DECISION_MODEL_PROVIDER=none
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
CUDA_VISIBLE_DEVICES=-1
NVIDIA_VISIBLE_DEVICES=void
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false

# Admission of consolidation remains with the existing protected owner.
HINDSIGHT_API_ENABLE_OBSERVATIONS=true
HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=false
HINDSIGHT_API_CONSOLIDATION_RECONCILE_INTERVAL_SECONDS=0
HINDSIGHT_API_MENTAL_MODEL_REFRESH_TICK_SECONDS=0
HINDSIGHT_API_PAGE_DEFAULT_TRIGGER={"refresh_after_consolidation":false}
HINDSIGHT_API_RETAIN_BATCH_ENABLED=false
HINDSIGHT_API_CONSOLIDATION_LLM_PARALLELISM=1
HINDSIGHT_API_CONSOLIDATION_MAX_ATTEMPTS=1
HINDSIGHT_API_WORKER_MAX_SLOTS=2
HINDSIGHT_API_WORKER_CONSOLIDATION_RESERVED_SLOTS=1
HINDSIGHT_API_WORKER_MAX_RETRIES=0

HINDSIGHT_API_MCP_ENABLED=false
HINDSIGHT_API_ENABLE_BANK_CONFIG_API=false
HINDSIGHT_API_ENABLE_BANK_LLM_HEALTH=false
HINDSIGHT_API_ENABLE_DRY_RUN_EXTRACT=false
HINDSIGHT_API_ENABLE_FILE_UPLOAD_API=false
HINDSIGHT_API_STORE_DOCUMENT_TEXT=true
HINDSIGHT_API_FAIL_ON_EXTRACTION_ERRORS=true
HINDSIGHT_API_LLM_TRACE_ENABLED=false
HINDSIGHT_API_OTEL_TRACES_ENABLED=false
# Set HINDSIGHT_API_WORKER_ENABLED=false on the API process only.
