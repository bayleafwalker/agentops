+# Common API + worker configuration. Replace placeholders through protected host
+# credentials. Do not put this file in the model-writable project directory.
+HINDSIGHT_API_DATABASE_URL=postgresql://hindsight:CHANGE_ME@postgres:5432/hindsight
+HINDSIGHT_API_DATABASE_SCHEMA=public
+HINDSIGHT_API_VECTOR_EXTENSION=pgvector
+HINDSIGHT_API_TEXT_SEARCH_EXTENSION=native
+HINDSIGHT_API_RUN_MIGRATIONS_ON_STARTUP=false
+
+HINDSIGHT_API_TENANT_EXTENSION=hindsight_ext_resident:ResidentTenantExtension
+HINDSIGHT_API_TENANT_POLICY_FILE=/etc/resident-memory/policy.json
+HINDSIGHT_API_OPERATION_VALIDATOR_EXTENSION=hindsight_ext_resident:ResidentOperationValidator
+HINDSIGHT_API_OPERATION_VALIDATOR_POLICY_FILE=/etc/resident-memory/policy.json
+
+# A single gateway owns hard budget admission for LLM AND embedding requests.
+# No direct vendor keys, per-operation overrides, or fallback members in the host.
+HINDSIGHT_API_LLM_PROVIDER=openai
+HINDSIGHT_API_LLM_BASE_URL=http://model-gateway:8080/v1
+HINDSIGHT_API_LLM_MODEL=REPLACE_WITH_GATEWAY_LLM_ALIAS
+HINDSIGHT_API_LLM_API_KEY=REPLACE_WITH_GATEWAY_CREDENTIAL
+HINDSIGHT_API_LLM_REQUEST_EXTENSION=hindsight_ext_bank_llm_routing:BankLLMRoutingExtension
+HINDSIGHT_API_LLM_REQUEST_ROUTES=[{"bank":"resident-story","schema":"public","provider":"openai","model":"REPLACE_WITH_GATEWAY_LLM_ALIAS"}]
+HINDSIGHT_API_LLM_REQUEST_UNMATCHED=deny
+HINDSIGHT_API_SKIP_LLM_VERIFICATION=true
+HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
+HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=http://model-gateway:8080/v1
+HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=REPLACE_WITH_GATEWAY_EMBEDDING_ALIAS
+HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=REPLACE_WITH_GATEWAY_CREDENTIAL
+HINDSIGHT_API_RERANKER_PROVIDER=rrf
+HINDSIGHT_API_DECISION_MODEL_PROVIDER=none
+
+# The supervisor schedules consolidation after budget admission. No autonomous
+# reconciliation/model/page sweeps. Observations remain enabled and durable.
+HINDSIGHT_API_ENABLE_OBSERVATIONS=true
+HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=false
+HINDSIGHT_API_CONSOLIDATION_RECONCILE_INTERVAL_SECONDS=0
+HINDSIGHT_API_MENTAL_MODEL_REFRESH_TICK_SECONDS=0
+HINDSIGHT_API_PAGE_DEFAULT_TRIGGER={"refresh_after_consolidation":false}
+HINDSIGHT_API_RETAIN_BATCH_ENABLED=false
+
+HINDSIGHT_API_MCP_ENABLED=false
+HINDSIGHT_API_ENABLE_BANK_CONFIG_API=false
+HINDSIGHT_API_ENABLE_BANK_LLM_HEALTH=false
+HINDSIGHT_API_ENABLE_DRY_RUN_EXTRACT=false
+HINDSIGHT_API_ENABLE_FILE_UPLOAD_API=false
+HINDSIGHT_API_STORE_DOCUMENT_TEXT=true
+HINDSIGHT_API_FAIL_ON_EXTRACTION_ERRORS=true
+HINDSIGHT_API_LLM_TRACE_ENABLED=false
+HINDSIGHT_API_OTEL_TRACES_ENABLED=false
+HINDSIGHT_API_LLM_MAX_CONCURRENT=2
+HINDSIGHT_API_LLM_MAX_RETRIES=1
+HINDSIGHT_API_EMBEDDINGS_MAX_CONCURRENT_REQUESTS=2
+HINDSIGHT_API_EMBEDDINGS_MAX_RETRIES=1
+HINDSIGHT_API_CONSOLIDATION_LLM_PARALLELISM=1
+HINDSIGHT_API_WORKER_MAX_SLOTS=2
+HINDSIGHT_API_WORKER_CONSOLIDATION_RESERVED_SLOTS=1
+HINDSIGHT_API_WORKER_MAX_RETRIES=2
+# Set HINDSIGHT_API_WORKER_ENABLED=false on the API process only.
diff --git a/hindsight-extensions/resident/tests/test_resident_policy.py b/hindsight-extensions/resident/tests/test_resident_policy.py
new file mode 100644
index 0000000000000000000000000000000000000000..0dd1a0b305b8f1b0b4224dc52f625d07a4b85222
--- /dev/null
+++ b/hindsight-extensions/resident/tests/test_resident_policy.py
@@ -0,0 +1,203 @@
+"""Contract checks at the extension boundary; API composition has its own system story."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+import pytest
+from hindsight_api.extensions.operation_validator import (
+    BankReadContext,
+    BankReadOperation,
+    BankWriteContext,
+    BankWriteOperation,
+    ConsolidateContext,
+    OperationValidationError,
+    PrecheckContext,
+    PrecheckOperation,
+    RecallContext,
+    RetainContext,
+    RetainFactsContext,
+    ReviewedFact,
+    TagScopeContext,
+)
+from hindsight_api.extensions.tenant import AuthenticationError
+from hindsight_api.models import RequestContext
+
+from hindsight_ext_resident import ResidentOperationValidator, ResidentTenantExtension
+from hindsight_ext_resident.policy import load_policy
+
+BANK = "resident-world"
+TOKEN = "test-only-high-entropy-credential-00000000000000000000000000000000"
+
+
+@dataclass
+class Extensions:
+    path: Path
+    tenant: ResidentTenantExtension
+    validator: ResidentOperationValidator
+
+    async def context(self, **kwargs: object) -> RequestContext:
+        context = RequestContext(api_key=TOKEN, **kwargs)
+        await self.tenant.authenticate(context)
+        return context
+
+
+@pytest.fixture
+def extensions(tmp_path: Path) -> Extensions:
+    policy = {
+        "schema_version": 1,
+        "database_schema": "public",
+        "principals": [
+            {
+                "id": "facade",
+                "token_sha256": hashlib.sha256(TOKEN.encode()).hexdigest(),
+                "grants": [
+                    {
+                        "bank": BANK,
+                        "operations": ["retain", "recall", "get_document", "list_banks"],
+                        "read_tags": ["project:world", "scope:published"],
+                        "write_tags": ["project:world", "scope:published", "topic:*"],
+                    }
+                ],
+            }
+        ],
+        "internal_grants": [{"bank": BANK, "operations": ["consolidate"]}],
+    }
+    path = tmp_path / "policy.json"
+    path.write_text(json.dumps(policy))
+    config = {"policy_file": str(path)}
+    return Extensions(path, ResidentTenantExtension(config), ResidentOperationValidator(config))
+
+
+@pytest.mark.parametrize("credential", [None, "", "invalid", TOKEN + "x"])
+async def test_authentication_rejects_missing_or_wrong_credentials(
+    extensions: Extensions, credential: str | None
+) -> None:
+    with pytest.raises(AuthenticationError):
+        await extensions.tenant.authenticate(RequestContext(api_key=credential))
+
+
+async def test_authentication_records_nonsecret_rotating_identity(extensions: Extensions) -> None:
+    context = await extensions.context()
+    assert context.tenant_id == "public"
+    assert context.api_key_id == extensions.tenant.policy.principals[0].key_id
+    assert TOKEN not in context.api_key_id
+    assert await extensions.tenant.get_allowed_config_fields(context, BANK) == set()
+    assert [tenant.schema for tenant in await extensions.tenant.list_tenants()] == ["public"]
+
+
+async def test_exact_bank_and_operation_permissions_and_strict_scopes(extensions: Extensions) -> None:
+    context = await extensions.context()
+    assert (await extensions.validator.validate_recall(RecallContext(BANK, "world", context))).allowed
+    with pytest.raises(OperationValidationError):
+        await extensions.validator.validate_recall(RecallContext(BANK + "-other", "world", context))
+    with pytest.raises(OperationValidationError):
+        await extensions.validator.validate_recall(RecallContext(BANK, "world", RequestContext(api_key=TOKEN)))
+    scope = await extensions.validator.resolve_tag_scope(TagScopeContext(BANK, context))
+    assert scope is not None and len(scope) == 1
+    assert scope[0].model_dump() == {
+        "tags": ["project:world", "scope:published"],
+        "match": "all_strict",
+        "resolve": "exact",
+    }
+    assert await extensions.validator.resolve_write_tag_scope(TagScopeContext(BANK, context)) == [
+        "project:world",
+        "scope:published",
+        "topic:*",
+    ]
+    assert (await extensions.validator.bank_list_scope(context)).bank_ids == [BANK]
+
+
+async def test_precheck_uses_rejection_result_for_dependency_error_mapping(extensions: Extensions) -> None:
+    result = await extensions.validator.precheck(
+        PrecheckContext(PrecheckOperation.RECALL, "forbidden-bank", await extensions.context())
+    )
+    assert not result.allowed and result.status_code == 403
+
+
+@pytest.mark.parametrize("operation", list(BankReadOperation))
+async def test_every_bank_read_hook_is_closed_by_default(extensions: Extensions, operation: BankReadOperation) -> None:
+    context = await extensions.context()
+    call = extensions.validator.validate_bank_read(BankReadContext(BANK, operation, context))
+    if operation == BankReadOperation.GET_DOCUMENT:
+        assert (await call).allowed
+    else:
+        with pytest.raises(OperationValidationError):
+            await call
+
+
+@pytest.mark.parametrize("operation", list(BankWriteOperation))
+async def test_every_bank_write_hook_is_closed_by_default(
+    extensions: Extensions, operation: BankWriteOperation
+) -> None:
+    with pytest.raises(OperationValidationError):
+        await extensions.validator.validate_bank_write(BankWriteContext(BANK, operation, await extensions.context()))
+
+
+@pytest.mark.parametrize("tags", [None, [], ["project:world"], ["project:world", "scope:published", "private:other"]])
+@pytest.mark.parametrize("queued", [False, True])
+async def test_scope_cannot_be_widened_or_omitted_on_retain(
+    extensions: Extensions, tags: list[str] | None, queued: bool
+) -> None:
+    context = await extensions.context(internal=queued, user_initiated=queued)
+    with pytest.raises(OperationValidationError):
+        await extensions.validator.validate_retain(RetainContext(BANK, [{"content": "note", "tags": tags}], context))
+
+
+async def test_queued_retain_checks_extracted_tags_and_current_identity(extensions: Extensions) -> None:
+    context = await extensions.context(internal=True, user_initiated=True)
+    tags = ["project:world", "scope:published", "topic:harbor"]
+    assert (await extensions.validator.validate_retain(RetainContext(BANK, [{"tags": tags}], context))).allowed
+    with pytest.raises(OperationValidationError):
+        await extensions.validator.filter_retain_facts(
+            RetainFactsContext(BANK, "doc-1", context, [ReviewedFact("leak", "world", [*tags, "private:other"], [])])
+        )
+    replacement = json.loads(extensions.path.read_text())
+    replacement["principals"][0]["token_sha256"] = hashlib.sha256(b"rotated-test-credential").hexdigest()
+    extensions.path.write_text(json.dumps(replacement))
+    restarted = ResidentOperationValidator({"policy_file": str(extensions.path)})
+    with pytest.raises(OperationValidationError):
+        await restarted.validate_retain(RetainContext(BANK, [{"tags": tags}], context))
+
+
+async def test_internal_is_not_a_permission_bypass(extensions: Extensions) -> None:
+    maintenance = RequestContext(internal=True, tenant_id="public")
+    assert (await extensions.validator.validate_consolidate(ConsolidateContext(BANK, maintenance))).allowed
+    with pytest.raises(OperationValidationError):
+        await extensions.validator.validate_recall(RecallContext(BANK, "everything", maintenance))
+    with pytest.raises(OperationValidationError):
+        await extensions.validator.validate_consolidate(ConsolidateContext("other", maintenance))
+    with pytest.raises(OperationValidationError):
+        await extensions.validator.validate_consolidate(ConsolidateContext(BANK, RequestContext(internal=True)))
+    maintenance.api_key_id = "revoked-key"
+    with pytest.raises(OperationValidationError):
+        await extensions.validator.validate_consolidate(ConsolidateContext(BANK, maintenance))
+
+
+@pytest.mark.parametrize(
+    "bad_field,bad_value", [("operations", ["*"]), ("read_tags", []), ("read_tags", ["project:*"])]
+)
+def test_invalid_policy_never_becomes_an_unrestricted_grant(
+    extensions: Extensions, bad_field: str, bad_value: object
+) -> None:
+    data = json.loads(extensions.path.read_text())
+    data["principals"][0]["grants"][0][bad_field] = bad_value
+    extensions.path.write_text(json.dumps(data))
+    with pytest.raises(ValueError, match="invalid") as error:
+        load_policy({"policy_file": str(extensions.path)})
+    assert data["principals"][0]["token_sha256"] not in str(error.value)
+
+
+def test_omitted_scope_and_unknown_settings_fail_startup(extensions: Extensions) -> None:
+    data = json.loads(extensions.path.read_text())
+    del data["principals"][0]["grants"][0]["read_tags"]
+    extensions.path.write_text(json.dumps(data))
+    with pytest.raises(ValueError):
+        load_policy({"policy_file": str(extensions.path)})
+    with pytest.raises(ValueError):
+        load_policy({"policy_file": str(extensions.path), "allow_all": "true"})
+    with pytest.raises(ValueError):
+        load_policy({"policy_file": "relative.json"})
