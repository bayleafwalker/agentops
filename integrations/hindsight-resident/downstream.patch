@@ -0,0 +1,207 @@
+"""A trusted facade and a split worker obey the same protected resident policy.
+
+Only the public Python client drives the server. Provider requests use the suite's
+strict deterministic stub; retain and consolidation run in the standalone worker.
+The adversarial private note is intentional: deployment policy normally gives each
+trust boundary its own bank, while this story also verifies tag confinement.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import uuid
+from collections.abc import Iterator
+from dataclasses import dataclass
+from pathlib import Path
+
+import pytest
+from hindsight_client import Hindsight
+from hindsight_client_api.exceptions import ForbiddenException, NotFoundException, UnauthorizedException
+
+from hindsight_system_tests.payloads import consolidation, extracted, fact
+from hindsight_system_tests.server import HindsightServer, start_hindsight_server, start_hindsight_worker
+from hindsight_system_tests.waiting import wait_until_settled
+
+pytestmark = pytest.mark.asyncio
+ROOT = Path(__file__).resolve().parents[2]
+SCHEMA = "systest_resident"
+FACADE_TOKEN = "test-resident-facade-0000000000000000000000000000000000000000000"
+OPERATOR_TOKEN = "test-resident-operator-00000000000000000000000000000000000000000"
+
+
+@dataclass
+class ResidentDeployment:
+    server: HindsightServer
+    worker: HindsightServer
+    bank: str
+
+
+@pytest.fixture
+def resident_deployment(stub_server, tmp_path: Path) -> Iterator[ResidentDeployment]:
+    bank = f"systest-resident-{uuid.uuid4().hex[:12]}"
+    read_ops = [
+        "recall",
+        "get_bank_profile",
+        "get_document",
+        "list_documents",
+        "list_memory_units",
+        "list_banks",
+        "list_operations",
+        "get_operation_status",
+    ]
+    policy = {
+        "schema_version": 1,
+        "database_schema": SCHEMA,
+        "principals": [
+            {
+                "id": "facade",
+                "token_sha256": hashlib.sha256(FACADE_TOKEN.encode()).hexdigest(),
+                "grants": [
+                    {
+                        "bank": bank,
+                        # The story exercises upstream auto-consolidation too. Its
+                        # submission uses the retained caller's context; an external
+                        # scoped caller is still refused bank-wide maintenance.
+                        "operations": ["retain", "submit_async_consolidation", *read_ops],
+                        "read_tags": ["project:story"],
+                        "write_tags": ["project:story", "source:*"],
+                    }
+                ],
+            },
+            {
+                "id": "operator",
+                "token_sha256": hashlib.sha256(OPERATOR_TOKEN.encode()).hexdigest(),
+                "grants": [
+                    {
+                        "bank": bank,
+                        "operations": [
+                            "create_bank",
+                            "update_bank",
+                            "delete_bank",
+                            "retain",
+                            "submit_async_consolidation",
+                            *read_ops,
+                        ],
+                        "read_tags": None,
+                        "write_tags": None,
+                    }
+                ],
+            },
+        ],
+        "internal_grants": [{"bank": bank, "operations": ["consolidate", "recall", "get_bank_profile"]}],
+    }
+    path = tmp_path / "resident-policy.json"
+    path.write_text(json.dumps(policy))
+    env = {
+        "HINDSIGHT_API_DATABASE_SCHEMA": SCHEMA,
+        "HINDSIGHT_API_TENANT_EXTENSION": "hindsight_ext_resident:ResidentTenantExtension",
+        "HINDSIGHT_API_TENANT_POLICY_FILE": str(path),
+        "HINDSIGHT_API_OPERATION_VALIDATOR_EXTENSION": "hindsight_ext_resident:ResidentOperationValidator",
+        "HINDSIGHT_API_OPERATION_VALIDATOR_POLICY_FILE": str(path),
+        "HINDSIGHT_API_LLM_REQUEST_EXTENSION": "hindsight_ext_bank_llm_routing:BankLLMRoutingExtension",
+        "HINDSIGHT_API_LLM_REQUEST_ROUTES": json.dumps([{"bank": bank, "schema": SCHEMA, "api_key": "stub-key"}]),
+        "HINDSIGHT_API_LLM_REQUEST_UNMATCHED": "deny",
+        "HINDSIGHT_API_SKIP_LLM_VERIFICATION": "true",
+        "HINDSIGHT_API_WORKER_MAX_SLOTS": "2",
+        "HINDSIGHT_API_WORKER_CONSOLIDATION_RESERVED_SLOTS": "1",
+        "HINDSIGHT_API_MCP_ENABLED": "false",
+        "HINDSIGHT_API_ENABLE_BANK_CONFIG_API": "false",
+        "PYTHONPATH": os.pathsep.join(
+            [
+                str(ROOT / "hindsight-extensions/resident"),
+                str(ROOT / "hindsight-extensions/bank-llm-routing"),
+            ]
+        ),
+    }
+    server = start_hindsight_server(
+        stub_url=stub_server.url,
+        log_path=tmp_path / "api.log",
+        extra_env={**env, "HINDSIGHT_API_WORKER_ENABLED": "false"},
+    )
+    try:
+        worker = start_hindsight_worker(stub_url=stub_server.url, log_path=tmp_path / "worker.log", extra_env=env)
+        try:
+            yield ResidentDeployment(server, worker, bank)
+        finally:
+            worker.stop()
+    finally:
+        server.stop()
+
+
+async def test_resident_facade_cannot_escape_its_bank_or_scope(resident_deployment: ResidentDeployment, llm) -> None:
+    deployment = resident_deployment
+    bank = deployment.bank
+    operator = Hindsight(base_url=deployment.server.url, api_key=OPERATOR_TOKEN)
+    facade = Hindsight(base_url=deployment.server.url, api_key=FACADE_TOKEN)
+    unknown = Hindsight(base_url=deployment.server.url, api_key="wrong-key")
+    llm.on_step("extract_facts", contains="The harbor closes").returns(
+        extracted(fact("The harbor closes at sunset", who="Harbor"))
+    )
+    llm.on_step("extract_facts", contains="Private access code").returns(
+        extracted(fact("The private access code is violet", who="Operator"))
+    )
+    llm.on_step("consolidate").returns(consolidation())
+    try:
+        await operator.acreate_bank(bank_id=bank, name="Resident policy story")
+        with pytest.raises(UnauthorizedException):
+            await unknown.arecall(bank_id=bank, query="harbor")
+        with pytest.raises(ForbiddenException):
+            await facade.arecall(bank_id=bank + "-other", query="harbor")
+        with pytest.raises(ForbiddenException):
+            await facade.aretain(bank_id=bank, content="Missing scope tag")
+        with pytest.raises(ForbiddenException):
+            await facade.aretain(bank_id=bank, content="Foreign tag", tags=["project:story", "private:operator"])
+        with pytest.raises(ForbiddenException):
+            await facade.banks.delete_bank(bank)
+
+        await operator.aretain(
+            bank_id=bank,
+            content="Private access code is violet.",
+            document_id="private-note",
+            tags=["private:operator"],
+        )
+        operation_id = str(uuid.uuid4())
+        first = await facade.aretain(
+            bank_id=bank,
+            content="The harbor closes at sunset.",
+            document_id="source-revision-1",
+            tags=["project:story", "source:revision-1"],
+            retain_async=True,
+            operation_id=operation_id,
+        )
+        repeated = await facade.aretain(
+            bank_id=bank,
+            content="The harbor closes at sunset.",
+            document_id="source-revision-1",
+            tags=["project:story", "source:revision-1"],
+            retain_async=True,
+            operation_id=operation_id,
+        )
+        assert first.operation_id == repeated.operation_id == operation_id
+        receipt = await facade.operations.get_operation_status(bank, operation_id)
+        assert receipt.status in {"pending", "processing", "completed"}
+        await wait_until_settled(operator, bank)
+        assert (await facade.operations.get_operation_status(bank, operation_id)).status == "completed"
+
+        # Caller filters cannot widen the strict extension scope. Even without a
+        # filter, the private note and its source document stay inaccessible.
+        recalled = await facade.arecall(bank_id=bank, query="harbor access", include_chunks=True)
