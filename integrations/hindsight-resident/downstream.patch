+const config = {
+  managedContext: true,
+  serverMode: "self-hosted" as const,
+  apiUrl: "https://memory.example.test",
+  apiToken: "reader-test-token",
+  managedScopeId: "resident-world-main",
+};
+const scope = { resident: "resident", project: "world", branch: "main" };
+const result = {
+  schema: "resident-memory-results/v1",
+  scope,
+  state: "available",
+  authorizes_effects: false,
+  entries: [
+    {
+      id: "memory-1",
+      content: "The harbor closes at sunset.",
+      status: "advisory",
+      scope,
+      source_refs: [{ source_id: "chapter-1", revision: "rev-1", sha256: "a".repeat(64) }],
+    },
+  ],
+  omissions: [],
+  ingestion: { state: "current" },
+};
+
+function client(apiUrl = config.apiUrl): HindsightClient {
+  return new HindsightClient({ apiUrl, apiToken: config.apiToken, bank: "unused-managed-bank" });
+}
+
+afterEach(() => vi.unstubAllGlobals());
