+    vi.stubGlobal("fetch", fetch);
+    const [tool] = buildManagedTools(client(), resolveConfig(config));
+    expect((await tool.handler({ query: "猫".repeat(1366) })).isError).toBe(true);
+    expect(fetch).not.toHaveBeenCalled();
+    expect((await tool.handler({ query: "harbor" })).isError).toBe(true);
+    expect(fetch).toHaveBeenCalledTimes(1);
+  });
+
+  it.each(["http://127.0.0.1:8787", "http://localhost:8787", "http://[::1]:8787"])(
