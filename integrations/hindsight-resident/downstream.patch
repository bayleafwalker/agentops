index 0000000000000000000000000000000000000000..05b9719990dbc48c881df030ae99976faf04b2c6
--- /dev/null
+++ b/hindsight-extensions/resident/hindsight_ext_resident/policy.py
@@ -0,0 +1,135 @@
+"""Small, closed policy loaded once from a supervisor-owned file.
+
+The file is configuration, never model output. Bank ids are exact; only writable
+tag patterns use shell matching, matching Hindsight's own write-scope contract.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+from pathlib import Path
+from typing import Annotated, Literal
+
+from hindsight_api.extensions.operation_validator import BankReadOperation, BankWriteOperation, PrecheckOperation
+from pydantic import BaseModel, ConfigDict, Field, ValidationError, field_validator, model_validator
+
+Identifier = Annotated[str, Field(min_length=1, max_length=128, pattern=r"^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$")]
+
+# These names are the pinned upstream bank hooks plus the separately dispatched
+# hooks below. An upstream upgrade that adds an operation must be reviewed before
+# this extension grants it. There is deliberately no wildcard permission.
+OPERATIONS = frozenset(
+    {op.value for op in BankReadOperation}
+    | {op.value for op in BankWriteOperation}
+    | {op.value for op in PrecheckOperation}
+    | {"create_bank", "consolidate", "get_mental_model", "refresh_mental_model", "list_banks"}
+)
+
+
+class ClosedModel(BaseModel):
+    model_config = ConfigDict(extra="forbid", frozen=True)
+
+
+class BankPermissions(ClosedModel):
+    bank: Identifier
+    operations: list[str] = Field(min_length=1)
+
+    @field_validator("operations")
+    @classmethod
+    def known_operations(cls, value: list[str]) -> list[str]:
+        if len(value) != len(set(value)) or any(operation not in OPERATIONS for operation in value):
+            raise ValueError("operations must be unique, explicitly supported operation names")
+        return value
+
+
+class Grant(BankPermissions):
+    # Both are REQUIRED. null is an explicit whole-bank grant; omission is an error.
+    read_tags: list[str] | None
+    write_tags: list[str] | None
+
+    @field_validator("read_tags", "write_tags")
+    @classmethod
+    def valid_tags(cls, value: list[str] | None) -> list[str] | None:
+        if value is not None and (
+            not value or len(value) != len(set(value)) or any(not tag or tag != tag.strip() for tag in value)
+        ):
+            raise ValueError("use nonempty unique tags, or explicit null for unrestricted access")
+        return value
+
+    @field_validator("read_tags")
+    @classmethod
+    def exact_read_tags(cls, value: list[str] | None) -> list[str] | None:
+        if value is not None and any(any(char in tag for char in "*?[]") for tag in value):
+            raise ValueError("read_tags must be exact tags, not patterns")
+        return value
+
+
+class Principal(ClosedModel):
+    id: Identifier
+    token_sha256: str = Field(pattern=r"^[0-9a-f]{64}$", repr=False)
+    grants: list[Grant] = Field(min_length=1)
+
+    @model_validator(mode="after")
+    def unique_banks(self) -> Principal:
+        if len({grant.bank for grant in self.grants}) != len(self.grants):
+            raise ValueError("a principal must have exactly one grant per bank")
+        return self
+
+    @property
+    def key_id(self) -> str:
+        # Persisted on queued operations instead of the credential. Rotation makes
+        # a different id, so old queued user work is refused after a restart.
+        return f"resident:{self.token_sha256[:32]}"
+
+    def grant_for(self, bank: str) -> Grant | None:
+        return next((grant for grant in self.grants if grant.bank == bank), None)
+
+
+class ResidentPolicy(ClosedModel):
+    schema_version: Literal[1]
+    database_schema: str = Field(pattern=r"^[a-z_][a-z0-9_]{0,62}$")
+    principals: list[Principal] = Field(min_length=1)
+    # Explicit whole-bank engine maintenance. Empty disables it. These grants do
+    # not allow a queued user request to exceed the submitting principal's rights.
+    internal_grants: list[BankPermissions]
+
+    @model_validator(mode="after")
+    def unique_identities(self) -> ResidentPolicy:
+        for values in (
+            [principal.id for principal in self.principals],
+            [principal.token_sha256 for principal in self.principals],
+            [principal.key_id for principal in self.principals],
+            [grant.bank for grant in self.internal_grants],
+        ):
+            if len(values) != len(set(values)):
+                raise ValueError("policy identities, credentials and internal banks must be unique")
+        allowed_banks = {grant.bank for principal in self.principals for grant in principal.grants}
+        if any(grant.bank not in allowed_banks for grant in self.internal_grants):
+            raise ValueError("internal banks must also be declared in a principal grant")
+        return self
+
+    def principal_for_token(self, token: str) -> Principal | None:
+        digest = hashlib.sha256(token.encode()).hexdigest()
+        matched = None
+        # Always compare the whole policy, without logging the credential or digest.
+        for principal in self.principals:
+            if hmac.compare_digest(digest, principal.token_sha256):
+                matched = principal
+        return matched
+
+    def principal_for_key(self, key_id: str | None) -> Principal | None:
+        return next((principal for principal in self.principals if principal.key_id == key_id), None)
+
+
+def load_policy(config: dict[str, str]) -> ResidentPolicy:
+    """Fail startup for missing/unknown config without echoing secrets in errors."""
+    if set(config) != {"policy_file"}:
+        raise ValueError("resident extension requires exactly policy_file configuration")
+    path = Path(config["policy_file"])
+    if not path.is_absolute():
+        raise ValueError("resident policy_file must be an absolute protected path")
+    try:
+        return ResidentPolicy.model_validate_json(path.read_text(encoding="utf-8"))
+    except (OSError, ValidationError):
+        raise ValueError("resident policy is unreadable or invalid; validate the protected policy file") from None
