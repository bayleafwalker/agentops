+    const cfg = resolveConfig(config);
+    const tools = selectTools(cfg, client(), "raw-bank-must-never-be-sent");
+    expect(tools.map((tool) => tool.name)).toEqual(["memory_search"]);
+    const out = await tools[0].handler({ query: "harbor hours" });
+    expect(out.isError).toBeUndefined();
+    expect(JSON.parse(out.content[0].text)).toEqual(result);
+    expect(fetch).toHaveBeenCalledTimes(1);
+    const [url, request] = fetch.mock.calls[0];
+    expect(url).toBe("https://memory.example.test/v1/search");
+    expect(request.method).toBe("POST");
+    expect(request.redirect).toBe("error");
