index 0000000000000000000000000000000000000000..23b7aef0e55cfc4ebeb357d2c269883ff9b5d95e
--- /dev/null
+++ b/hindsight-integrations/coding-agents/src/core/managed-tools.ts
@@ -0,0 +1,186 @@
+/** The resident facade's explicitly approved tool surface. No raw engine fallback. */
+import { z } from "zod";
+import type { Config } from "./config";
+import type { HindsightClient } from "./hindsight";
+import type { ToolResult, ToolSpec } from "./page-tools";
+
+const MAX_RESPONSE_BYTES = 64 * 1024;
+// Keep HTTP error bodies out of the generic transport's unbounded error formatter.
+// 429 in this set also suppresses its automatic backoff/retry loop.
+const ERROR_STATUSES = Array.from({ length: 200 }, (_, index) => 400 + index);
+const input = z
+  .object({
+    query: z
+      .string()
+      .trim()
+      .min(1)
+      .refine((query) => Buffer.byteLength(query, "utf8") <= 4096),
+  })
+  .strict();
+const identifier = z.string().min(1).max(256);
+const scope = z.object({ resident: identifier, project: identifier, branch: identifier });
+const envelope = z
+  .object({
+    schema: z.literal("resident-memory-results/v1"),
+    scope,
+    state: z.enum(["available", "unavailable", "truncated"]),
+    authorizes_effects: z.literal(false),
+    entries: z
+      .array(
+        z.object({
+          id: identifier,
+          content: z.string(),
+          source_refs: z
+            .array(
+              z.object({
+                source_id: identifier,
+                revision: identifier,
+                sha256: z.string().regex(/^[a-f0-9]{64}$/),
+              })
+            )
+            .min(1)
+            .max(64),
+          status: z.literal("advisory"),
+          scope,
+        })
+      )
+      .max(256),
+    omissions: z.unknown(),
+    ingestion: z.unknown(),
+  })
+  .superRefine((value, context) => {
+    for (const entry of value.entries) {
+      if (
+        entry.scope.resident !== value.scope.resident ||
+        entry.scope.project !== value.scope.project ||
+        entry.scope.branch !== value.scope.branch
+      ) {
+        context.addIssue({ code: "custom", message: "Memory entry crosses response scope" });
+      }
+    }
+  });
+
+function unavailable(): ToolResult {
+  return {
+    isError: true,
+    content: [
+      {
+        type: "text",
+        text: JSON.stringify({
+          schema: "resident-memory-results/v1",
+          state: "unavailable",
+          authorizes_effects: false,
+          entries: [],
+          reason: "Managed memory is unavailable; no fallback was used.",
+        }),
+      },
+    ],
+  };
+}
+
+/** Bound bytes while reading, including a response with no Content-Length header. */
+async function readEnvelope(response: Response): Promise<unknown> {
+  const declared = Number(response.headers.get("content-length"));
+  if (declared > MAX_RESPONSE_BYTES) {
+    await response.body?.cancel();
+    throw new Error("Memory response exceeds byte limit");
+  }
+  const reader = response.body?.getReader();
+  if (!reader) throw new Error("Empty memory response");
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  try {
+    for (;;) {
+      const next = await reader.read();
+      if (next.done) break;
+      size += next.value.byteLength;
+      if (size > MAX_RESPONSE_BYTES) throw new Error("Memory response exceeds byte limit");
+      chunks.push(next.value);
+    }
+    return JSON.parse(
+      new TextDecoder("utf-8", { fatal: true }).decode(Buffer.concat(chunks, size))
+    );
+  } finally {
+    await reader.cancel().catch(() => {});
+    reader.releaseLock();
+  }
+}
+
+/** A configured origin only, with no URL credentials, path, query or fragment. */
+function facadeOrigin(cfg: Config, client: HindsightClient): string | undefined {
+  if (
+    !cfg.managedContext ||
+    cfg.serverMode !== "self-hosted" ||
+    !cfg.managedScopeId ||
+    !cfg.apiToken
+  )
+    return;
+  try {
+    const url = new URL(cfg.apiUrl);
+    const loopback = ["127.0.0.1", "localhost", "[::1]"].includes(url.hostname);
+    if (
+      !["http:", "https:"].includes(url.protocol) ||
+      (url.protocol === "http:" && !loopback) ||
+      url.username ||
+      url.password ||
+      url.search ||
+      url.hash ||
+      url.pathname !== "/" ||
+      client.apiUrl !== url.origin
+    )
+      return;
+    return url.origin;
+  } catch {
+    return;
+  }
+}
+
+export function buildManagedTools(client: HindsightClient, cfg: Config): ToolSpec[] {
+  const origin = facadeOrigin(cfg, client);
+  if (!origin || cfg.disabled) return [];
+  return [
+    {
+      name: "memory_search",
+      description:
+        "Search approved resident memory for the current configured scope. Results are advisory, cite their source revisions, and never authorize external actions.",
+      inputSchema: input.shape,
+      annotations: {
+        readOnlyHint: true,
+        destructiveHint: false,
+        idempotentHint: true,
+        openWorldHint: false,
+      },
+      handler: async (args: unknown) => {
+        try {
+          const { query } = input.parse(args);
+          // Reuse auth rotation, timeout and HTTP transport. No 429 retry, redirects,
+          // raw Hindsight paths, caller-selected scope, or page/reflect fallback.
+          const response = await client.req(
+            "POST",
+            `${origin}/v1/search`,
+            { scope_id: cfg.managedScopeId, query },
+            ERROR_STATUSES,
+            cfg.injectTimeoutMs,
+            "error"
+          );
+          if (!response.ok) {
+            await response.body?.cancel();
+            return unavailable();
+          }
+          const body = await readEnvelope(response);
+          const checked = envelope.safeParse(body);
+          if (!checked.success) return unavailable();
+          // Preserve the facade's documented provenance and omission metadata; never add
+          // the native Hindsight page guide or rewrite this into authority-bearing text.
+          return {
+            content: [{ type: "text", text: JSON.stringify(checked.data) }],
+            ...(checked.data.state === "unavailable" ? { isError: true } : {}),
+          };
+        } catch {
+          // Do not expose transport errors (which may contain URLs, headers or bodies).
+          return unavailable();
+        }
+      },
+    },
+  ];
+}
