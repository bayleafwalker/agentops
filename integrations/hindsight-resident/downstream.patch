index 0000000000000000000000000000000000000000..32df2259af5f25bf8bad4c6bd1a016339a1c4381
--- /dev/null
+++ b/hindsight-extensions/resident/tests/test_service_config.py
@@ -0,0 +1,51 @@
+"""The deployment template uses real knobs from the pinned server, with bounded workers."""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+import pytest
+from hindsight_api import config as server_config
+
+from hindsight_ext_resident.policy import load_policy
+
+EXTENSION_DIR = Path(__file__).resolve().parents[1]
+
+
+def test_example_policy_and_service_configuration_are_valid(monkeypatch: pytest.MonkeyPatch) -> None:
+    policy = load_policy({"policy_file": str(EXTENSION_DIR / "policy.example.json")})
+    assert policy.database_schema == "public"
+    for name in list(os.environ):
+        if name.startswith("HINDSIGHT_API_"):
+            monkeypatch.delenv(name)
+    known_names = {
+        value for name, value in vars(server_config).items() if name.startswith("ENV_") and isinstance(value, str)
+    }
+    extension_names = {
+        "HINDSIGHT_API_TENANT_EXTENSION",
+        "HINDSIGHT_API_TENANT_POLICY_FILE",
+        "HINDSIGHT_API_OPERATION_VALIDATOR_EXTENSION",
+        "HINDSIGHT_API_OPERATION_VALIDATOR_POLICY_FILE",
+        "HINDSIGHT_API_LLM_REQUEST_EXTENSION",
+        "HINDSIGHT_API_LLM_REQUEST_ROUTES",
+        "HINDSIGHT_API_LLM_REQUEST_UNMATCHED",
+        "HINDSIGHT_API_WORKER_CONSOLIDATION_RESERVED_SLOTS",
+    }
+    for line in (EXTENSION_DIR / "service.env.example").read_text().splitlines():
+        if not line or line.startswith("#"):
+            continue
+        key, value = line.split("=", 1)
+        assert key in known_names | extension_names, f"unknown pinned-server setting: {key}"
+        monkeypatch.setenv(key, value)
+    config = server_config.HindsightConfig.from_env()
+    assert config.database_schema == policy.database_schema
+    assert config.worker_max_slots == 2
+    assert config.worker_slot_reservations["consolidation"] == 1
+    assert not config.enable_auto_consolidation
+    assert not config.enable_bank_config_api
+    assert not config.mcp_enabled
+    assert config.consolidation_reconcile_interval_seconds == 0
+    assert config.mental_model_refresh_tick_seconds == 0
+    assert config.page_default_trigger == {"refresh_after_consolidation": False}
+    assert config.reranker_provider == "rrf"
