index 0000000000000000000000000000000000000000..3b3042053ce1999942f8b48bcf91edd7f3f0ab0b
--- /dev/null
+++ b/hindsight-extensions/resident/hindsight_ext_resident/extension.py
@@ -0,0 +1,202 @@
+"""Authentication and default-deny authorization through upstream extension hooks."""
+
+from __future__ import annotations
+
+import logging
+
+from hindsight_api.engine.search.tags import TagGroup, TagGroupLeaf, tags_writable
+from hindsight_api.extensions.operation_validator import (
+    BankListContext,
+    BankListResult,
+    BankListScope,
+    BankReadContext,
+    BankWriteContext,
+    ConsolidateContext,
+    ConsolidationActionsContext,
+    CreateBankContext,
+    ImportContext,
+    MemoryReview,
+    MemoryUpdateContext,
+    MentalModelCandidateContext,
+    MentalModelGetContext,
+    MentalModelRefreshContext,
+    OperationValidationError,
+    OperationValidatorExtension,
+    PrecheckContext,
+    RecallContext,
+    ReflectContext,
+    RetainContext,
+    RetainFactsContext,
+    TagScopeContext,
+    ValidationResult,
+)
+from hindsight_api.extensions.tenant import AuthenticationError, Tenant, TenantContext, TenantExtension
+from hindsight_api.models import RequestContext
+
+from hindsight_ext_resident.policy import BankPermissions, Grant, Principal, load_policy
+
+DENIED = "Resident policy does not permit this operation"
+logger = logging.getLogger(__name__)
+
+
+class ResidentTenantExtension(TenantExtension):
+    """One database schema, authenticated keys, and immutable server-owned config."""
+
+    def __init__(self, config: dict[str, str]) -> None:
+        super().__init__(config)
+        self.policy = load_policy(config)
+
+    async def authenticate(self, context: RequestContext) -> TenantContext:
+        principal = self.policy.principal_for_token(context.api_key) if context.api_key else None
+        if principal is None:
+            raise AuthenticationError("Invalid resident credential")
+        context.api_key_id = principal.key_id
+        context.tenant_id = self.policy.database_schema
+        return TenantContext(schema_name=self.policy.database_schema)
+
+    async def list_tenants(self) -> list[Tenant]:
+        return [Tenant(schema=self.policy.database_schema, tenant_id=self.policy.database_schema)]
+
+    async def get_allowed_config_fields(self, context: RequestContext, bank_id: str) -> set[str]:
+        return set()
+
+
+class ResidentOperationValidator(OperationValidatorExtension):
+    """Apply the same bank permissions to HTTP requests and identifiable queued work.
+
+    Hindsight bypasses tag resolvers for internal work. User-initiated queued retain
+    therefore repeats tag checks here and in the extracted-fact hook. Background
+    consolidation is explicitly bank-wide and separately granted. Use a separate
+    bank for each trust boundary; tags do not sandbox an LLM processing that bank.
+    """
+
+    def __init__(self, config: dict[str, str]) -> None:
+        super().__init__(config)
+        self.policy = load_policy(config)
+
+    def _principal(self, context: RequestContext) -> Principal:
+        principal = self.policy.principal_for_key(context.api_key_id)
+        if context.tenant_id != self.policy.database_schema or principal is None:
+            raise OperationValidationError(DENIED)
+        return principal
+
+    def _permissions(self, bank: str, context: RequestContext) -> BankPermissions:
+        if context.internal and not context.user_initiated:
+            if context.tenant_id != self.policy.database_schema:
+                raise OperationValidationError(DENIED)
+            # An originating credential, when present, must still exist and still
+            # have this bank. Maintenance sweeps have no originating credential.
+            if context.api_key_id is not None and self._principal(context).grant_for(bank) is None:
+                raise OperationValidationError(DENIED)
+            permissions = next((grant for grant in self.policy.internal_grants if grant.bank == bank), None)
+        else:
+            permissions = self._principal(context).grant_for(bank)
+        if permissions is None:
+            raise OperationValidationError(DENIED)
+        return permissions
+
+    def _allow(self, bank: str, operation: str, context: RequestContext) -> ValidationResult:
+        try:
+            permissions = self._permissions(bank, context)
+            if operation not in permissions.operations:
+                raise OperationValidationError(DENIED)
+        except OperationValidationError:
+            logger.info(
+                "resident_policy_denied operation=%r bank=%r key_id=%r internal=%s user_initiated=%s",
+                operation,
+                bank,
+                context.api_key_id,
+                context.internal,
+                context.user_initiated,
+            )
+            raise
+        return ValidationResult.accept()
+
+    def _check_tags(self, bank: str, context: RequestContext, tags: list[str] | None) -> None:
+        permissions = self._permissions(bank, context)
+        if not isinstance(permissions, Grant):
+            return
+        if not tags_writable(tags, permissions.write_tags):
+            raise OperationValidationError("Resident policy does not permit these write tags")
+        if permissions.read_tags is not None and not set(permissions.read_tags).issubset(tags or []):
+            raise OperationValidationError("Resident writes must carry every required scope tag")
+
+    async def precheck(self, ctx: PrecheckContext) -> ValidationResult:
+        operation = {
+            "mental_model_create": "create_mental_model",
+            "mental_model_refresh": "refresh_mental_model",
+        }.get(ctx.operation, ctx.operation)
+        # This hook runs in a FastAPI dependency, outside the engine's domain-error
+        # mapping. Its contract is a rejected result, not a raised domain exception.
+        try:
+            return self._allow(ctx.bank_id, operation, ctx.request_context)
+        except OperationValidationError:
+            return ValidationResult.reject(DENIED)
+
+    async def validate_retain(self, ctx: RetainContext) -> ValidationResult:
+        result = self._allow(ctx.bank_id, "retain", ctx.request_context)
+        for item in ctx.contents:
+            self._check_tags(ctx.bank_id, ctx.request_context, item.get("tags"))
+        return result
+
+    async def filter_retain_facts(self, ctx: RetainFactsContext) -> list[MemoryReview] | None:
+        self._allow(ctx.bank_id, "retain", ctx.request_context)
+        for fact in ctx.facts:
+            self._check_tags(ctx.bank_id, ctx.request_context, fact.tags)
+        return None
+
+    async def validate_recall(self, ctx: RecallContext) -> ValidationResult:
+        return self._allow(ctx.bank_id, "recall", ctx.request_context)
+
+    async def validate_reflect(self, ctx: ReflectContext) -> ValidationResult:
+        return self._allow(ctx.bank_id, "reflect", ctx.request_context)
+
+    async def validate_consolidate(self, ctx: ConsolidateContext) -> ValidationResult:
+        return self._allow(ctx.bank_id, "consolidate", ctx.request_context)
+
+    async def filter_consolidation_actions(self, ctx: ConsolidationActionsContext) -> list[MemoryReview] | None:
+        self._allow(ctx.bank_id, "consolidate", ctx.request_context)
+        return None
+
+    async def validate_bank_read(self, ctx: BankReadContext) -> ValidationResult:
+        return self._allow(ctx.bank_id, ctx.operation, ctx.request_context)
+
+    async def validate_bank_write(self, ctx: BankWriteContext) -> ValidationResult:
+        return self._allow(ctx.bank_id, ctx.operation, ctx.request_context)
+
+    async def validate_create_bank(self, ctx: CreateBankContext) -> ValidationResult:
+        return self._allow(ctx.bank_id, "create_bank", ctx.request_context)
+
+    async def validate_import(self, ctx: ImportContext) -> ValidationResult:
+        return self._allow(ctx.bank_id, "import_documents", ctx.request_context)
+
+    async def validate_mental_model_get(self, ctx: MentalModelGetContext) -> ValidationResult:
+        return self._allow(ctx.bank_id, "get_mental_model", ctx.request_context)
+
+    async def validate_mental_model_refresh(self, ctx: MentalModelRefreshContext) -> ValidationResult:
+        operation = "create_mental_model" if ctx.mental_model_id is None else "refresh_mental_model"
+        return self._allow(ctx.bank_id, operation, ctx.request_context)
+
+    async def validate_mental_model_candidate(self, ctx: MentalModelCandidateContext) -> ValidationResult:
+        return self._allow(ctx.bank_id, "refresh_mental_model", ctx.request_context)
+
+    async def validate_memory_update(self, ctx: MemoryUpdateContext) -> ValidationResult:
+        return self._allow(ctx.bank_id, "update_memory_unit", ctx.request_context)
+
+    async def resolve_tag_scope(self, ctx: TagScopeContext) -> list[TagGroup] | None:
+        permissions = self._permissions(ctx.bank_id, ctx.request_context)
+        if isinstance(permissions, Grant) and permissions.read_tags is not None:
+            return [TagGroupLeaf(tags=permissions.read_tags, match="all_strict")]
+        return None
+
+    async def resolve_write_tag_scope(self, ctx: TagScopeContext) -> list[str] | None:
+        permissions = self._permissions(ctx.bank_id, ctx.request_context)
+        return permissions.write_tags if isinstance(permissions, Grant) else None
+
+    async def bank_list_scope(self, request_context: RequestContext) -> BankListScope:
+        principal = self._principal(request_context)
+        return BankListScope(bank_ids=[grant.bank for grant in principal.grants if "list_banks" in grant.operations])
+
+    async def filter_bank_list(self, ctx: BankListContext) -> BankListResult:
+        scope = await self.bank_list_scope(ctx.request_context)
+        return BankListResult(banks=[bank for bank in ctx.banks if bank.get("bank_id") in (scope.bank_ids or [])])
