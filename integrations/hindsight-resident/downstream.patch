@@ -0,0 +1,24 @@
+# Build the upstream api-only image from the pinned commit first, then pass its
+# immutable local tag/digest with --build-arg HINDSIGHT_IMAGE=... . No latest fallback.
+ARG HINDSIGHT_IMAGE
+FROM ${HINDSIGHT_IMAGE}
+USER hindsight
+
+COPY hindsight-extensions/resident/hindsight_ext_resident /app/extensions/hindsight_ext_resident
+COPY hindsight-extensions/bank-llm-routing/hindsight_ext_bank_llm_routing /app/extensions/hindsight_ext_bank_llm_routing
+COPY LICENSE /usr/share/licenses/resident-hindsight/LICENSE
+ENV PYTHONPATH=/app/extensions
+ENV HINDSIGHT_API_TENANT_EXTENSION=hindsight_ext_resident:ResidentTenantExtension \
+    HINDSIGHT_API_TENANT_POLICY_FILE=/etc/resident-memory/policy.json \
+    HINDSIGHT_API_OPERATION_VALIDATOR_EXTENSION=hindsight_ext_resident:ResidentOperationValidator \
+    HINDSIGHT_API_OPERATION_VALIDATOR_POLICY_FILE=/etc/resident-memory/policy.json \
+    HINDSIGHT_API_MCP_ENABLED=false \
+    HINDSIGHT_API_ENABLE_BANK_CONFIG_API=false
+
+# The server loads the first .env found above its cwd with override=True. Keep it
+# away from project worktrees; run the container with a read-only root filesystem.
+WORKDIR /opt/resident-service
+COPY hindsight-extensions/resident/trusted.env /opt/resident-service/.env
+RUN /app/api/.venv/bin/python -c "from importlib.metadata import version; assert version('hindsight-api-slim') == '1.2.1'; import hindsight_ext_resident, hindsight_ext_bank_llm_routing"
+
+CMD ["hindsight-api", "--host", "0.0.0.0", "--port", "8888", "--workers", "1"]
