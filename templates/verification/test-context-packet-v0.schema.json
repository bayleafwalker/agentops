{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentOps Test Context Packet v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "owner_repo", "subject", "backends", "actors", "initial_state", "operations", "consistency", "invariants", "faults", "oracles", "implementation_anchors", "expansions"],
  "properties": {
    "schema_version": { "const": "test-context/v0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "owner_repo": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "subject": { "type": "string", "minLength": 1 },
    "backends": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "actors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "initial_state": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "operations": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": true, "required": ["name"] } },
    "consistency": { "type": "object", "additionalProperties": false, "required": ["target", "object"], "properties": { "target": { "type": "string", "minLength": 1 }, "object": { "type": "string", "minLength": 1 } } },
    "invariants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "faults": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "oracles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "implementation_anchors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "expansions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
