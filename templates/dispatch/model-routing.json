{
  "schema_version": 1,
  "caller_harness_providers": {
    "claude": "anthropic",
    "codex": "codex",
    "kimi": "kimi"
  },
  "worker_harness_providers": {
    "opencode": "opencode-go"
  },
  "worker_routes": {
    "note": "Bulk implementation workers for the supervised hybrid mode. These are never caller harnesses: a worker holds no git, sprintctl, deployment, or acceptance authority. The governing contract is templates/dispatch/hybrid/hybrid-dispatch.v1.json.",
    "bulk": {
      "opencode": {
        "model": "opencode-go/deepseek-v4-flash",
        "agent": "ao-bulk",
        "verified": true,
        "qualified": false,
        "max_attempts": 2
      }
    },
    "substantial": {
      "opencode": {
        "model": "opencode-go/kimi-k2.7-code",
        "agent": "ao-substantial",
        "verified": true,
        "qualified": false,
        "max_attempts": 1
      }
    },
    "escalation": {
      "opencode": {
        "model": "opencode-go/glm-5.2",
        "agent": "ao-escalation",
        "verified": true,
        "qualified": false,
        "max_attempts": 1
      }
    },
    "worker-review-challenger": {
      "opencode": {
        "model": "opencode-go/kimi-k3",
        "agent": "ao-review",
        "verified": true,
        "qualified": false,
        "max_attempts": 1,
        "note": "Read-only challenger. Never substitutes for the coordinator review required by the dispatch contract."
      }
    }
  },
  "aliases": {
    "clerical": {
      "anthropic": {
        "model": "claude-haiku-4-5-20251001",
        "verified": true
      },
      "codex": {
        "model": "gpt-5.6-luna",
        "verified": true
      }
    },
    "frontier-default": {
      "anthropic": {
        "model": "claude-fable-5",
        "fallback": "claude-opus-4-8",
        "verified": true
      },
      "codex": {
        "model": "gpt-5.6-sol",
        "verified": true
      }
    },
    "frontier-plan": {
      "anthropic": {
        "model": "claude-opus-4-8",
        "verified": true
      },
      "codex": {
        "model": "gpt-5.6-sol",
        "verified": true
      }
    },
    "frontier-review": {
      "anthropic": {
        "model": "claude-opus-4-8",
        "verified": true
      },
      "codex": {
        "model": "gpt-5.6-sol",
        "verified": true
      }
    },
    "review-synthesis": {
      "anthropic": {
        "model": "claude-sonnet-5",
        "verified": true
      },
      "codex": {
        "model": "gpt-5.6-terra",
        "verified": true
      }
    },
    "release-ops": {
      "anthropic": {
        "model": "claude-sonnet-5",
        "verified": true
      },
      "codex": {
        "model": "gpt-5.6-terra",
        "verified": true
      }
    },
    "fast-build": {
      "anthropic": {
        "model": "claude-sonnet-5",
        "verified": true
      },
      "codex": {
        "model": "gpt-5.3-codex-spark",
        "fallback": "gpt-5.6-luna",
        "verified": true,
        "transport": "chatgpt",
        "surfaces": ["codex-cli", "codex-app", "vscode-extension"],
        "note": "2026-07-22: Spark is the preferred bounded fast-build model when the caller is an authenticated Codex surface. It has a separate preview usage limit and is not generally API-accessible; API-key workers and exhausted/unavailable Spark sessions fall back to gpt-5.6-luna."
      }
    },
    "standard-build": {
      "anthropic": {
        "model": "claude-sonnet-5",
        "verified": true
      },
      "codex": {
        "model": "gpt-5.6-terra",
        "verified": true
      }
    },
    "hard-build": {
      "anthropic": {
        "model": "claude-sonnet-5",
        "fallback": "claude-opus-4-8",
        "verified": true,
        "note": "2026-07-20: claude-sonnet-5 replaces claude-opus-4-8 as the default for semantically hard bulk build/verify work (state-protocol semantics, read-path/parity/staleness logic) now that Sonnet 5 is available in this harness; opus-4-8 kept only as fallback."
      },
      "codex": {
        "model": "gpt-5.6-terra",
        "verified": true,
        "note": "Semantically hard implementation remains a Terra workload when its architecture and acceptance contract are already decided; route unresolved architecture and cross-repository decisions through frontier-plan instead."
      }
    }
  }
}
