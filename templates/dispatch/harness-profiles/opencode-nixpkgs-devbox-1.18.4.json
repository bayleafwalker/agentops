{
  "schema_version": "harness-profile/v1",
  "profile_id": "opencode-nixpkgs-devbox-1.18.4",
  "semantic_adapter": "opencode-noninteractive/v1",
  "host_class": "devbox-agent",
  "worker_identity": "agentworker",
  "implementation": {
    "channel": "nixpkgs/nixos-unstable",
    "package": "opencode",
    "cli_version": "1.18.4"
  },
  "invocation": {
    "command": ["opencode", "run"],
    "message_before_file": true,
    "stdin": "closed"
  },
  "policy": {
    "config_file": "opencode.actionq-worker.json",
    "overlay_transport": "OPENCODE_CONFIG_CONTENT"
  },
  "lifecycle": {
    "event_format": "json",
    "event_stream": "stdout",
    "session_id_field": "properties.sessionID",
    "continuation": {
      "mode": "same-session",
      "session_flag": "--session",
      "continue_flag": "--continue",
      "fork": false
    },
    "contained_identity": {
      "worker_user": "agentworker",
      "enforced_by": "filesystem-and-uid",
      "probe": "contained-identity"
    },
    "finalizer": {
      "agent": "ao-finalizer",
      "tools": [],
      "same_session": true
    }
  },
  "required_probes": [
    "cli-version",
    "run-help",
    "contained-worktree-model-list",
    "explicit-tool-enumeration",
    "message-before-file",
    "json-events",
    "stable-session-identity",
    "session-continuation",
    "contained-identity",
    "no-tools-finalizer"
  ],
  "receipt_fields": [
    "semantic_adapter",
    "profile_id",
    "cli_version",
    "executable_fingerprint",
    "channel_revision",
    "profile_digest",
    "config_digest",
    "overlay_digest",
    "provider_model",
    "worker_identity",
    "capability_probe_results",
    "lifecycle_probe_results"
  ],
  "qualification": {
    "state": "preflight_observed",
    "blocking_probes": [
      "contained-identity",
      "provider-qualification"
    ]
  }
}
