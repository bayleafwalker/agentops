{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.kotona.app/schemas/harness-profile/v1",
  "title": "Harness implementation profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "semantic_adapter",
    "host_class",
    "worker_identity",
    "implementation",
    "invocation",
    "policy",
    "lifecycle",
    "required_probes",
    "receipt_fields",
    "qualification"
  ],
  "properties": {
    "schema_version": {"const": "harness-profile/v1"},
    "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "semantic_adapter": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "host_class": {"type": "string", "minLength": 1},
    "worker_identity": {"type": "string", "pattern": "^[a-z_][a-z0-9_-]*[$]?$"},
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "package", "cli_version"],
      "properties": {
        "channel": {"type": "string", "minLength": 1},
        "package": {"type": "string", "minLength": 1},
        "cli_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "message_before_file", "stdin"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "message_before_file": {"type": "boolean"},
        "stdin": {"enum": ["closed"]}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_file", "overlay_transport"],
      "properties": {
        "config_file": {"type": "string", "minLength": 1},
        "overlay_transport": {"const": "OPENCODE_CONFIG_CONTENT"}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_format",
        "event_stream",
        "session_id_field",
        "continuation",
        "contained_identity",
        "finalizer"
      ],
      "properties": {
        "event_format": {"const": "json"},
        "event_stream": {"const": "stdout"},
        "session_id_field": {"const": "properties.sessionID"},
        "continuation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "session_flag", "continue_flag", "fork"],
          "properties": {
            "mode": {"const": "same-session"},
            "session_flag": {"const": "--session"},
            "continue_flag": {"const": "--continue"},
            "fork": {"const": false}
          }
        },
        "contained_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["worker_user", "enforced_by", "probe"],
          "properties": {
            "worker_user": {"type": "string", "minLength": 1},
            "enforced_by": {"const": "filesystem-and-uid"},
            "probe": {"const": "contained-identity"}
          }
        },
        "finalizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agent", "tools", "same_session"],
          "properties": {
            "agent": {"const": "ao-finalizer"},
            "tools": {"const": []},
            "same_session": {"const": true}
          }
        }
      }
    },
    "required_probes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "receipt_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "blocking_probes"],
      "properties": {
        "state": {"enum": ["preflight_observed", "qualified", "superseded"]},
        "blocking_probes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
