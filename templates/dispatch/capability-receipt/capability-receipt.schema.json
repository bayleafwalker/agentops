{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/capability-receipt.schema.json",
  "title": "Capability receipt",
  "description": "A capability delta at a project boundary, not an activity record.",
  "$comment": "The dependency-free Python validator is normative for semantic constraints. This schema is a structural and editor aid. `established_by` records provenance -- who or what established this receipt and on what authority. It is not authentication, and it is not a workflow stage: an actor_type of human is provenance, not approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project",
    "as_of",
    "boundary",
    "status",
    "before",
    "after",
    "locus",
    "evidence",
    "counterfactual",
    "transfer",
    "dependency",
    "belief_changed",
    "displaced_alternative",
    "would_disconfirm",
    "unknowns",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "capability-receipt/v1",
        "capability-receipt/v2"
      ]
    },
    "id": {
      "$ref": "#/$defs/receiptIdentifier",
      "description": "Must begin with the exact project value followed by a dot; cross-field prefix matching is enforced by the normative validator."
    },
    "project": {
      "$ref": "#/$defs/identifier"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "release",
            "sprint-close",
            "experiment-killed",
            "operating-change"
          ]
        },
        "ref": {
          "$ref": "#/$defs/immutableRef"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sprint-close"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "properties": {
                  "kind": {
                    "const": "sprint-event"
                  },
                  "source": {
                    "description": "Identifies the local Sprintctl database project and sprint. This is not content-bound or migration-stable.",
                    "pattern": "^sprintctl:[A-Za-z0-9][A-Za-z0-9._-]*:sprint:[A-Za-z0-9][A-Za-z0-9._-]*$"
                  },
                  "revision": {
                    "pattern": "^event:[1-9][0-9]*$"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "status": {
      "enum": [
        "draft",
        "current",
        "superseded"
      ],
      "description": "Document lifecycle. `ratified` was removed in v2: a claim is current or it is not, and who established it is provenance recorded in `established_by`."
    },
    "before": {
      "$ref": "#/$defs/nonBlankString"
    },
    "after": {
      "$ref": "#/$defs/nonBlankString"
    },
    "locus": {
      "enum": [
        "embodied",
        "delegated",
        "governed",
        "institutionalised"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "observation"
        ],
        "properties": {
          "ref": {
            "$ref": "#/$defs/immutableRef"
          },
          "observation": {
            "$ref": "#/$defs/nonBlankString"
          }
        }
      }
    },
    "expectation_ref": {
      "$ref": "#/$defs/immutableRef"
    },
    "counterfactual": {
      "$ref": "#/$defs/nonBlankString"
    },
    "transfer": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "dependency": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "belief_changed": {
      "$ref": "#/$defs/nonBlankString"
    },
    "displaced_alternative": {
      "$ref": "#/$defs/nonBlankString"
    },
    "would_disconfirm": {
      "$ref": "#/$defs/nonBlankString"
    },
    "unknowns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "reason"
        ],
        "properties": {
          "field": {
            "$ref": "#/$defs/nonBlankString"
          },
          "reason": {
            "$ref": "#/$defs/nonBlankString"
          }
        }
      }
    },
    "publication": {
      "enum": [
        "private",
        "candidate",
        "published"
      ]
    },
    "supersedes": {
      "$ref": "#/$defs/receiptRef"
    },
    "established_by": {
      "type": "object",
      "description": "Provenance and authority basis for establishing this receipt. Declared, not authenticated.",
      "additionalProperties": false,
      "required": [
        "actor",
        "actor_type",
        "at",
        "authority_basis",
        "decision_ref"
      ],
      "properties": {
        "actor": {
          "$ref": "#/$defs/nonBlankString"
        },
        "actor_type": {
          "enum": [
            "human",
            "agent",
            "automation"
          ],
          "description": "Provenance only. No actor_type confers or withholds authority."
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "authority_basis": {
          "enum": [
            "delegated",
            "standing-policy"
          ],
          "description": "On what basis the actor was entitled to establish this. No basis is owner-reserved: authority is either delegated or carried by standing policy."
        },
        "decision_ref": {
          "$ref": "#/$defs/immutableRef"
        }
      }
    },
    "validity": {
      "type": "object",
      "description": "The interval over which this receipt is the operative claim. Orthogonal to kind, state and provenance.",
      "additionalProperties": false,
      "required": [
        "effective_from"
      ],
      "properties": {
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "basis_for": {
      "type": "array",
      "uniqueItems": true,
      "description": "Identifiers this receipt is the basis for. Presence makes it canonical; its dependents are the change blast radius. Canonicality is a dependency relation, never approval, maturity or permanence.",
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "receiptIdentifier": {
      "allOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "description": "A project-prefixed receipt id with at least one non-empty suffix character.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      ]
    },
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "immutableRef": {
      "type": "object",
      "description": "A source identity plus a kind-specific exact revision. Durability is kind-dependent; sprint-event is only a source-local database row identity.",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "revision"
      ],
      "properties": {
        "kind": {
          "enum": [
            "git-commit",
            "sprint-event",
            "document",
            "verification-result",
            "release",
            "artifact"
          ]
        },
        "source": {
          "$ref": "#/$defs/nonBlankString"
        },
        "revision": {
          "$ref": "#/$defs/nonBlankString"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "git-commit"
            },
            "revision": {
              "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "sprint-event"
            },
            "revision": {
              "description": "A source-local database event id, not a content digest or migration-stable identity.",
              "pattern": "^event:[1-9][0-9]*$"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "artifact"
            },
            "revision": {
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "verification-result"
            },
            "revision": {
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "document"
            },
            "revision": {
              "pattern": "^([0-9a-f]{40}|[0-9a-f]{64}|sha256:[0-9a-f]{64})$"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "release"
            },
            "revision": {
              "pattern": "^([0-9a-f]{40}|[0-9a-f]{64}|sha256:[0-9a-f]{64})$"
            }
          }
        }
      ]
    },
    "receiptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "draft"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "established_by"
              ]
            },
            {
              "required": [
                "validity"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "current"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "established_by",
          "validity",
          "supersedes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "established_by",
          "validity",
          "supersedes"
        ],
        "properties": {
          "validity": {
            "required": [
              "effective_to"
            ],
            "properties": {
              "effective_to": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication": {
            "enum": [
              "candidate",
              "published"
            ]
          }
        },
        "required": [
          "publication"
        ]
      },
      "then": {
        "required": [
          "established_by",
          "validity",
          "supersedes"
        ],
        "properties": {
          "status": {
            "enum": [
              "current",
              "superseded"
            ]
          }
        }
      }
    }
  ]
}
