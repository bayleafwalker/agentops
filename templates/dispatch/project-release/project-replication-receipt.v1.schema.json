{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/project-replication-receipt.v1.schema.json",
  "title": "AgentOps project replication receipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "descriptor_sha256", "package_sha256", "source_host", "verifier_host", "verified_at", "outcome", "members", "replica_refs", "retention"],
  "properties": {
    "schema": { "const": "project-replication-receipt/v1" },
    "descriptor_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "package_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_host": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$" },
    "verifier_host": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$" },
    "verified_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "outcome": { "enum": ["verified", "failed"] },
    "members": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["repo_id", "kind", "result", "commit", "bundle_sha256"], "properties": { "repo_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }, "kind": { "enum": ["remote-ref", "bundle"] }, "result": { "const": "verified" }, "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "bundle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } },
    "replica_refs": { "type": "array", "items": { "type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$" } },
    "retention": { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "enum": ["pinned", "expires"] }, "retain_until": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" } }, "allOf": [{ "if": { "properties": { "mode": { "const": "expires" } } }, "then": { "required": ["retain_until"] } }, { "if": { "properties": { "mode": { "const": "pinned" } } }, "then": { "not": { "required": ["retain_until"] } } }] }
  }
}
