{
  "schema_version": 1,
  "repo_id": "appservice",
  "adoption_level": "dispatchable",
  "routing": {
    "default_harness": "claude",
    "default_model_alias": "fast-build",
    "action_classes": {
      "plan": {
        "enabled": true,
        "model_alias": "frontier-plan"
      },
      "build": {
        "enabled": true,
        "model_alias": "fast-build",
        "review_required": true
      },
      "review": {
        "enabled": true,
        "model_alias": "review-synthesis"
      },
      "verify": {
        "enabled": true,
        "model_alias": "review-synthesis",
        "review_required": true
      },
      "reconcile": {
        "enabled": true,
        "model_alias": "review-synthesis"
      },
      "release-ops": {
        "enabled": true,
        "model_alias": "release-ops"
      }
    }
  },
  "skills": {
    "template_root": "/projects/dev/agentops/templates/dispatch/skills",
    "selected": [
      "dispatch-plan",
      "dispatch-build",
      "dispatch-review",
      "code-change-verification",
      "pr-handoff-summary",
      "verify-state-protocols",
      "reconcile-project-contracts"
    ],
    "overlays": [
      ".agents/overlays/appservice.state-protocols.md"
    ]
  },
  "scope": {
    "allowed_path_roots": [
      "clusters/",
      "docs/"
    ],
    "out_of_scope": [
      "plaintext secret values",
      "manual cluster mutation except explicit verification reads"
    ]
  },
  "risk_surfaces": [
    {
      "id": "flux-desired-live-convergence",
      "paths": ["clusters/main/kubernetes/**"],
      "skills": ["verify-state-protocols", "reconcile-project-contracts"],
      "context_ids": ["appservice.flux.desired-live-convergence"],
      "default_depth": 1,
      "required_on_change": true
    },
    {
      "id": "backup-restore-readiness",
      "paths": ["docs/operations/**", "docs/training/health-checks/**", ".github/workflows/**"],
      "skills": ["verify-state-protocols", "reconcile-project-contracts"],
      "context_ids": ["appservice.backup.restore-readiness"],
      "default_depth": 1,
      "required_on_change": false
    }
  ],
  "verification": {
    "command_families": [
      "kustomize",
      "secrets",
      "docs"
    ],
    "targeted_first": true,
    "commands": [
      "kustomize build clusters/main/kubernetes/<category>",
      "python /projects/dev/agentops/templates/dispatch/scripts/validate_verification_artifacts.py --root .",
      "sops --decrypt <changed-secret-file> >/dev/null"
    ]
  },
  "hooks": {
    "level": "audit",
    "publishers": [
      "git",
      "workspace-cost",
      "dispatcher-gate"
    ]
  }
}
