{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/hybrid-task-packet.schema.json",
  "title": "Agentops hybrid dispatch task packet",
  "description": "A frozen bounded implementation packet handed to one disposable OpenCode worker loop. The coordinator authors it; the worker never edits it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "repo_id",
    "sprint_item",
    "route",
    "task_class",
    "risk",
    "oracle",
    "starting_commit",
    "purpose",
    "readable_context_paths",
    "writable_patch_paths",
    "protected_paths",
    "required_outcomes",
    "acceptance_properties",
    "non_goals",
    "allowed_command_ids",
    "limits",
    "network_policy",
    "worktree"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "agentops-task/v1",
        "agentops-task/v2"
      ],
      "description": "v1 packets remain readable for receipt/replay compatibility. New packets use v2, whose acceptance properties have stable ids."
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+-[A-Za-z0-9._-]+$"
    },
    "repo_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "sprint_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "claim_id",
        "claim_actor"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+#[0-9]+$",
          "description": "sprintctl item reference as repo#id."
        },
        "claim_actor": {
          "type": "string",
          "minLength": 1,
          "description": "Actor holding the sprintctl claim. Always the coordinator, never the worker."
        },
        "claim_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Exact live claim id held by claim_actor for this packet."
        }
      }
    },
    "route": {
      "type": "string",
      "enum": [
        "mechanical_bulk",
        "bindery_external_runtime_w0"
      ]
    },
    "task_class": {
      "type": "string",
      "const": "mechanical_implementation"
    },
    "risk": {
      "type": "string",
      "const": "low"
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership",
        "worker_may_modify",
        "description"
      ],
      "properties": {
        "ownership": {
          "type": "string",
          "const": "externally_defined"
        },
        "worker_may_modify": {
          "type": "boolean",
          "const": false
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "starts_red": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Command ids the coordinator asserts are RED at starting_commit, because the oracle for this packet is a test that does not pass yet. prepare requires exactly these to fail and every other registered command to pass: a starts_red command that is already green means the oracle does not discriminate, and the packet is refused rather than dispatched against a gate that cannot fail."
        },
        "reference_patch": {
          "type": "string",
          "minLength": 1,
          "description": "Optional repo-relative path (under docs/evidence/packets/ or similar) to a unified diff that is a reference solution. validate applies it at starting_commit in a throwaway checkout, rejects it if it touches anything outside writable_patch_paths, and requires every starts_red command to go green. Absent, the report records oracle_satisfiable_within_paths as skipped:no-reference, never true. A cheap-tier packet SHOULD carry one; it is mandatory once L-3 self_candidate is on for the class."
        }
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "supersedes": {
      "type": "string",
      "description": "task_id of the failed packet this corrected retry replaces."
    },
    "starting_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "readable_context_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "writable_patch_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protected_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_properties": {
      "type": "array",
      "minItems": 1,
      "description": "Coordinator-authored deterministic failure properties. Each relevant requirement needs a gate that fails when the requirement is ignored. v2 requires a packet-unique stable id."
    },
    "non_goals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_command_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Command ids resolved against the repository hybrid.commands map. Free-form shell is never granted."
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 5400
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "soft_token_ceiling": {
          "type": "integer",
          "minimum": 1
        },
        "hard_token_ceiling": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "context_churn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_repeated_reads_per_path",
        "max_reasoning_steps_without_mutation",
        "max_identical_context_tokens",
        "handoff_when_candidate_ready"
      ],
      "properties": {
        "max_repeated_reads_per_path": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "max_reasoning_steps_without_mutation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "max_identical_context_tokens": {
          "type": "integer",
          "minimum": 1000
        },
        "handoff_when_candidate_ready": {
          "const": true
        }
      },
      "description": "Coordinator-authored stall limits. These target repeated unchanged context and mutation-free churn, not cheap cache writes generally. Enforcement is harness-side when telemetry permits and otherwise recorded in the receipt."
    },
    "network_policy": {
      "type": "string",
      "enum": [
        "disabled"
      ]
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "branch",
        "cleanup"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "cleanup": {
          "type": "string",
          "enum": [
            "remove-on-disposition",
            "retain-for-review"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coordinator_context": {
          "type": "string",
          "enum": [
            "independent",
            "same-session"
          ],
          "default": "independent"
        },
        "challenger_enabled": {
          "type": "boolean",
          "default": false
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "acceptance_property_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "command_id",
        "fails_when"
      ],
      "properties": {
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "fails_when": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptance_property_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement",
        "command_id",
        "fails_when"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
          "description": "Packet-unique stable requirement identifier, for example REQ-001."
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "fails_when": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "agentops-task/v1"
          }
        }
      },
      "then": {
        "properties": {
          "acceptance_properties": {
            "items": {
              "$ref": "#/$defs/acceptance_property_v1"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "agentops-task/v2"
          }
        }
      },
      "then": {
        "properties": {
          "acceptance_properties": {
            "items": {
              "$ref": "#/$defs/acceptance_property_v2"
            }
          }
        }
      }
    }
  ]
}
