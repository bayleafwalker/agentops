{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "provider": {
    "local3090": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local RTX 3090 (llama-swap)",
      "options": {
        "baseURL": "http://127.0.0.1:8020/v1",
        "apiKey": "local-only"
      },
      "models": {
        "worker-fast": {
          "name": "3090 Worker Fast (Qwen3.6-35B-A3B)",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "tools": true
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "edit": "allow",
    "write": "allow",
    "patch": "allow",
    "bash": { "*": "deny" },
    "task": "deny",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  },
  "agent": {
    "ao-mechanical-bulk": {
      "description": "Low-ambiguity mechanical implementation against an externally supplied oracle and discriminating gates.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0,
      "permission": {
        "task": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "ao-bindery-external-runtime-w0": {
      "description": "Project-scoped mechanical implementation for bindery-core W0; no authority, credentials, network, or oracle ownership.",
      "mode": "primary",
      "model": "local3090/worker-fast",
      "temperature": 0,
      "permission": {
        "task": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "ao-bounded-semantic": {
      "description": "Assessment-only bounded semantic implementation; no production route authority.",
      "mode": "primary",
      "model": "opencode-go/kimi-k2.7-code",
      "permission": {
        "task": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "ao-review": {
      "description": "Benchmark-only read-only K3 agent; never a production challenger or substitute for coordinator review.",
      "mode": "primary",
      "model": "opencode-go/kimi-k3",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "ao-finalizer": {
      "description": "Same-session terminal synthesis only; no investigation, mutation, or other tools.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0,
      "permission": {
        "*": "deny",
        "read": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "todowrite": "deny",
        "todoread": "deny",
        "edit": "deny",
        "write": "deny",
        "patch": "deny",
        "bash": "deny",
        "task": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  }
}
