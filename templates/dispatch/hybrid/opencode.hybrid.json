{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "permission": {
    "*": "ask",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  },
  "agent": {
    "ao-mechanical-bulk": {
      "description": "Low-ambiguity mechanical implementation against an externally supplied oracle and discriminating gates.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0,
      "permission": {
        "task": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "ao-bounded-semantic": {
      "description": "Assessment-only bounded semantic implementation; no production route authority.",
      "mode": "primary",
      "model": "opencode-go/kimi-k2.7-code",
      "permission": {
        "task": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "ao-review": {
      "description": "Benchmark-only read-only K3 agent; never a production challenger or substitute for coordinator review.",
      "mode": "primary",
      "model": "opencode-go/kimi-k3",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "ao-finalizer": {
      "description": "Same-session terminal synthesis only; no investigation, mutation, or other tools.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0,
      "permission": {
        "*": "deny",
        "read": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "todowrite": "deny",
        "todoread": "deny",
        "edit": "deny",
        "write": "deny",
        "patch": "deny",
        "bash": "deny",
        "task": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  }
}
