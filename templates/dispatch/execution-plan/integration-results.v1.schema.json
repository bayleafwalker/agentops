{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.kotona.app/schemas/integration-results/v1",
  "title": "Ordered immutable candidate results for integration",
  "type": "object", "additionalProperties": false,
  "required": ["contract_id", "integration_id", "member_results"],
  "properties": {
    "contract_id": {"const": "integration-results/v1"},
    "integration_id": {"type": "string", "minLength": 1},
    "member_results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["entry_id", "result_ref"],
        "properties": {
          "entry_id": {"type": "string", "minLength": 1},
          "result_ref": {"type": "string", "pattern": "^artifact:sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
