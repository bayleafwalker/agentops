{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.kotona.app/schemas/dispatch-plan-source/v1",
  "title": "Dispatch plan compiler source v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "plan_id", "repositories", "entries", "integrations", "execution"],
  "properties": {
    "contract_id": {"const": "dispatch-plan-source/v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "repositories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repository"}},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "integrations": {"type": "array", "items": {"$ref": "#/$defs/integration"}},
    "execution": {"$ref": "#/$defs/execution"}
  },
  "$defs": {
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_id", "repository_url", "commit"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "repository_url": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    },
    "work": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "selected_revision", "observed_revision"],
      "properties": {
        "item_id": {"type": "integer", "minimum": 1},
        "selected_revision": {"type": "string", "minLength": 1},
        "observed_revision": {"type": "string", "minLength": 1}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "repository_id", "work", "topology", "integration_lane", "command_id", "allowed_paths", "required_capabilities", "worker_profile", "acceptance_gates"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "repository_id": {"type": "string", "minLength": 1},
        "work": {"$ref": "#/$defs/work"},
        "topology": {"enum": ["independent", "stacked", "wave-integrated"]},
        "base_entry_id": {"type": "string", "minLength": 1},
        "integration_lane": {"type": ["string", "null"], "minLength": 1},
        "command_id": {"type": "string", "minLength": 1},
        "allowed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "worker_profile": {"type": "string", "minLength": 1},
        "acceptance_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "integration": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "repository_id", "member_ids", "base_commit", "verification_profile", "review_required"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "repository_id": {"type": "string", "minLength": 1},
        "member_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "verification_profile": {"type": "string", "minLength": 1}, "review_required": {"type": "boolean"}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false, "required": ["max_parallel", "failure_policy"],
      "properties": {"max_parallel": {"type": "integer", "minimum": 1, "maximum": 32}, "failure_policy": {"const": "continue-independent"}}
    }
  }
}
