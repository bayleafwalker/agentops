{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/verification-result.schema.json",
  "title": "State protocol verification result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "contract_ref",
    "implementation_sha",
    "depth",
    "environment",
    "execution",
    "claims",
    "counterexamples"
  ],
  "properties": {
    "schema_version": { "const": "verification-result/v1" },
    "context_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_id", "revision"],
      "properties": {
        "doc_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "implementation_sha": { "type": "string", "minLength": 7 },
    "depth": { "type": "integer", "minimum": 0, "maximum": 3 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend"],
      "properties": {
        "backend": { "type": "string", "minLength": 1 },
        "isolation": { "type": "string" },
        "tool_versions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["histories", "faults_exercised"],
      "properties": {
        "seed": { "type": ["integer", "string", "null"] },
        "histories": { "type": "integer", "minimum": 0 },
        "bounds": { "type": "object", "additionalProperties": { "type": ["integer", "string", "boolean"] } },
        "faults_exercised": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["property", "result"],
        "properties": {
          "property": { "type": "string", "minLength": 1 },
          "result": {
            "enum": ["formally-checked", "exhaustively-checked-within-bound", "property-tested", "concurrency-tested", "example-tested", "documented-only", "unknown"]
          },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary"],
        "properties": {
          "summary": { "type": "string", "minLength": 1 },
          "trace_ref": { "type": "string" },
          "seed": { "type": ["integer", "string", "null"] }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
