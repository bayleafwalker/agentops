  "routes": {
    "POST /api/session": {
      "request_fields": [
        "id?",
        "parentID?",
        "title?",
        "agent?",
        "model?",
        "location?",
        "metadata?",
        "permissions?"
      ],
      "response": "200 {data: Session.Info}",
      "notes": "No directory query parameter on create. Session.Info returns selected model and permissions."
    },
    "POST /api/session/{sessionID}/model": {
      "request": {
        "model": {
          "$ref": "#/components/schemas/Model.Ref"
        }
      },
      "response": "204 No Content"
    },
    "PATCH /api/session/{sessionID}": {
      "request_fields": [
        "title?",
        "metadata?",
        "permissions?"
      ],
      "response": "204 No Content",
      "notes": "Model is absent from the OpenAPI request schema. A model-only PATCH returned 204 but a follow-up GET showed the selected model unchanged."
    },
    "POST /api/session/{sessionID}/prompt": {
      "request_fields": [
        "id?",
        "text",
        "files?",
        "agents?",
        "skills?",
        "metadata?",
        "delivery?",
        "resume?"
      ],
      "response": "200 {data: Session.Inbox.User}"
    },
    "GET /api/session/{sessionID}/inbox": {
      "response": "200 {data: Session.Inbox.Info[]}"
    },
    "GET /api/session/{sessionID}/message": {
      "response": "200 {data: Session.Message.Info[], cursor: {previous, next}}"
    }
  },
  "observations": [
    {
      "case": "model-at-create-and-update",
      "result": "PASS",
      "detail": "Creating a session with model {id: never-connect, providerID: local-fake} returned 200 and GET returned that model (variant default). POST /model with a second fake model returned 204; GET reflected the new model."
    },
    {
      "case": "patch-model-field",
      "result": "NO-OP",
      "detail": "PATCH with only a model field returned 204, but GET confirmed the model remained the value set by POST /model."
    },
    {
      "case": "duplicate-prompt-id",
      "result": "ID-DEDUP-OBSERVED",
      "detail": "Two POST /prompt calls with id msg_probe_same_id both returned 200 and the same ID. The second response returned the first stored text; GET messages contained one user row for that ID. Inbox was empty after processing. This establishes duplicate-ID coalescing in this probe, not a general exactly-once guarantee for downstream processing."
    },
    {
      "case": "inference-suppression",
      "result": "PASS",
      "detail": "Prompts used an unconfigured local-fake provider/model and the server ran in an isolated network namespace. No external inference was possible; transcript reported model unavailable."
    }
  ],
  "limitations": [
    "The duplicate-ID probe used identical prompt IDs and a fake unavailable model. It does not establish idempotency across sessions or all delivery modes.",
    "The isolated probes accessed no production server, configuration, or credentials."
  ],
  "schema_scope": "selected schema excerpts only; not a standalone validation schema"
}
