+"""A JSON Schema subset checker that says what it does not check.
+
+There is no ``jsonschema`` on this host, so the schema files in this repo are
+enforced by hand or not at all. This module is the hand: a small checker for the
+subset of JSON Schema those files actually use, in a module a script can import
+rather than inside a test where only that test can reach it.
+
+The rule that makes it trustworthy is :data:`SUPPORTED_KEYWORDS`. A checker that
+skips a keyword it does not implement reports a clean bill of health for a
+constraint it never looked at, which is worse than no checker at all -- the
+schema says ``minItems: 1`` and the reader believes it is enforced. So an
+unrecognised keyword raises :class:`UnsupportedKeyword` rather than passing.
+Keywords that genuinely carry no constraint are skipped **by name** through
+:data:`ANNOTATION_KEYWORDS`, never by a catch-all.
+
+Auditing names alone is not enough, and the manifest schema is the proof: it
+uses ``additionalProperties`` in its subschema form, which a name audit waves
+through and this checker cannot enforce -- the same silent skip, one level
+down. So a keyword used in a *form* that is recognised but unenforced raises
+as well.
+
+Consequence worth stating plainly: this module does not yet implement the
+composition keywords (``$ref``, ``allOf``, ``if``/``then``, ``oneOf``, ``not``,
+``propertyNames``, ``minItems``, ``minProperties``, ``maximum``), so the two real
+schema files in this repo raise here today. That is the honest report. Adding
+them is the next row; until then nothing can mistake "did not check" for "passed".
+"""
+from __future__ import annotations
+
+import json
+import re
+
+#: Keywords this checker enforces. Every one of them can fail an instance.
+SUPPORTED_KEYWORDS = frozenset({
+    "type",
+    "required",
+    "properties",
+    "additionalProperties",
+    "items",
+    "enum",
+    "const",
+    "pattern",
+    "minLength",
+    "minimum",
+    "uniqueItems",
+})
+
+#: Keywords that carry no constraint on an instance. Listed by name so that a
+#: keyword is never skipped merely because nobody thought about it.
+ANNOTATION_KEYWORDS = frozenset({
+    "$schema",
+    "$id",
+    "$comment",
+    "title",
+    "description",
+    "default",
+    "examples",
+    "deprecated",
+    "format",
+})
+
+_TYPES = {
+    "object": dict,
+    "array": list,
+    "string": str,
+    "integer": int,
+    "number": (int, float),
+    "boolean": bool,
+}
+
+
+class UnsupportedKeyword(Exception):
+    """A schema used a keyword this checker does not implement.
+
+    Raised rather than ignored: the caller asked whether an instance satisfies a
+    schema, and the honest answer to "I cannot read part of it" is not "yes".
+    """
+
+
+def _subschemas(schema: dict, path: str):
+    """The subschemas of ``schema``, with the breadcrumb each one sits at."""
+    properties = schema.get("properties")
+    if isinstance(properties, dict):
+        for name, sub in properties.items():
+            yield sub, f"{path}.{name}"
+    if "items" in schema:
+        yield schema["items"], f"{path}[]"
+
+
+#: Keywords this checker enforces in one form only, with the form it enforces.
+#: Auditing names alone would let the *shape* it cannot handle through: the
+#: keyword is recognised, the audit passes, and the constraint is then silently
+#: ignored one level down -- which is the very failure the audit exists to stop,
+#: merely relocated. So the shape is audited too.
+_ENFORCED_SHAPES = {
+    # The subschema form (a dict) constrains the extra properties rather than
+    # forbidding them. ``True`` and absent both constrain nothing, so ignoring
+    # them is honest and neither raises.
+    "additionalProperties": lambda v: not isinstance(v, dict),
+    # The positional/tuple form (a list) gives each index its own schema.
+    "items": lambda v: not isinstance(v, list),
+    # The union form (a list of type names).
+    "type": lambda v: not isinstance(v, list),
+}
+
+
+def _assert_supported(schema, path: str) -> None:
+    """Raise on the first keyword, or keyword *form*, this checker cannot enforce.
+
+    Walks the whole schema, not just the level in hand, and not only the parts
+    some instance happens to reach: a keyword buried in an optional property is
+    exactly the one that would otherwise go unnoticed for the longest. The
+    question this answers is whether the schema is honestly enforced, which has
+    nothing to do with any particular instance.
+    """
+    if isinstance(schema, bool):
+        # JSON Schema permits a bare ``true``/``false`` in schema position.
+        raise UnsupportedKeyword(
+            f"{path}: a boolean schema is not implemented by schema_check; "
+            "it would otherwise be silently unchecked"
+        )
+    for keyword, value in schema.items():
+        if keyword in ANNOTATION_KEYWORDS:
+            continue
+        if keyword not in SUPPORTED_KEYWORDS:
+            raise UnsupportedKeyword(
+                f"{path}: schema keyword {keyword!r} is not implemented by "
+                "schema_check; it would otherwise be silently unchecked"
+            )
+        shape_ok = _ENFORCED_SHAPES.get(keyword)
+        if shape_ok is not None and not shape_ok(value):
+            raise UnsupportedKeyword(
+                f"{path}: schema keyword {keyword!r} is used in a form "
+                "schema_check does not implement; it would otherwise be "
+                "silently unchecked"
+            )
+    for sub, sub_path in _subschemas(schema, path):
+        _assert_supported(sub, sub_path)
+
+
+def _is_bool(value) -> bool:
+    return isinstance(value, bool)
+
+
+def validate(instance, schema, path: str = "$") -> list[str]:
+    """Return every way ``instance`` violates ``schema``; empty means it holds.
+
+    Messages are human-readable and each is prefixed with the breadcrumb of the
+    value it is about, so a violation in a nested array reads
+    ``$.skills.selected[1]: ...`` and a reader can go straight to it.
+
+    Raises :class:`UnsupportedKeyword` if the schema uses a keyword this module
+    does not implement.
+    """
+    _assert_supported(schema, path)
+    return _validate(instance, schema, path)
+
+
+def _validate(instance, schema: dict, path: str) -> list[str]:
+    errors: list[str] = []
+
+    expected = schema.get("type")
+    if expected:
+        wanted = _TYPES[expected]
+        # bool is an int in Python; the schema means the two separately, and a
+        # flag arriving where a count belongs is a real defect, not a curiosity.
+        if expected in ("integer", "number") and _is_bool(instance):
+            errors.append(f"{path}: expected {expected}, got boolean")
+            return errors
+        if not isinstance(instance, wanted):
+            errors.append(
+                f"{path}: expected {expected}, got {type(instance).__name__}")
+            # Stop here. Descending into a value of the wrong shape produces a
+            # cascade of confused messages about the first real one.
+            return errors
+
+    if "const" in schema and instance != schema["const"]:
+        errors.append(f"{path}: expected const {schema['const']!r}, got {instance!r}")
+    if "enum" in schema and instance not in schema["enum"]:
+        errors.append(f"{path}: {instance!r} not in enum {schema['enum']}")
+
+    if isinstance(instance, str):
+        pattern = schema.get("pattern")
+        if pattern is not None and not re.match(pattern, instance):
+            errors.append(f"{path}: {instance!r} does not match {pattern}")
+        min_length = schema.get("minLength")
+        if min_length is not None and len(instance) < min_length:
+            errors.append(f"{path}: shorter than minLength {min_length}")
+
+    if isinstance(instance, (int, float)) and not _is_bool(instance):
+        minimum = schema.get("minimum")
+        if minimum is not None and instance < minimum:
+            errors.append(f"{path}: {instance} below minimum {minimum}")
+
+    if isinstance(instance, dict):
+        for key in schema.get("required", []):
+            if key not in instance:
+                errors.append(f"{path}: missing required property {key!r}")
+        properties = schema.get("properties", {})
+        for key, value in instance.items():
+            if key in properties:
+                errors.extend(_validate(value, properties[key], f"{path}.{key}"))
+            elif schema.get("additionalProperties") is False:
+                errors.append(f"{path}: additional property {key!r} is not allowed")
+
+    if isinstance(instance, list):
+        item_schema = schema.get("items")
+        if isinstance(item_schema, dict):
+            for index, item in enumerate(instance):
+                errors.extend(_validate(item, item_schema, f"{path}[{index}]"))
+        if schema.get("uniqueItems"):
+            # By value, not identity: two dicts with the same pairs in a
+            # different order are the same item as far as a schema is concerned.
+            seen = [json.dumps(item, sort_keys=True) for item in instance]
+            if len(set(seen)) != len(seen):
+                errors.append(f"{path}: items are not unique")
+
+    return errors
