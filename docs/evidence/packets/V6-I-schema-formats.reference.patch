+def _is_uuid(value):
+    """The canonical hyphenated form only.
+
+    The URN and braced spellings are rejected deliberately: this checks the
+    format a manifest is expected to carry, and accepting three spellings for
+    one identifier is how two records of the same thing stop comparing equal.
+    """
+    return _UUID_RE.fullmatch(value) is not None
