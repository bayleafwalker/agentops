--- a/templates/dispatch/scripts/release_scorecard.py
+++ b/templates/dispatch/scripts/release_scorecard.py
@@ -160,4 +160,84 @@ def build_scorecard(release, rows, receipts, escalations, recorded_at):
             "total": round(frontier["cost_usd"] + worker["cost_usd"], 6),
             "total_reliable": worker["cost_reported"],
         },
+    }
+
+
+def _rework_of(card):
+    return card["frontier"]["rework_rounds"]
+
+
+def _escalations_of(card):
+    return card["escalations"]["count"]
+
+
+def _turns_cost_of(card):
+    return [card["frontier"]["turns"], card["cost_usd"]["total"]]
+
+
+def _rework_worsened(a, b):
+    return _rework_of(b) > _rework_of(a)
+
+
+def _escalations_worsened(a, b):
+    return _escalations_of(b) > _escalations_of(a)
+
+
+def _turns_flat_cost_up(a, b):
+    """Turns failed to drop while cost rose.
+
+    The whole programme's goal is frontier turns *dropping*; turns that do not
+    drop while cost rises means paying more for the same frontier attention.
+    Turns that actually drop are the goal, so that case stays quiet however
+    the cost moved.
+    """
+    return (
+        b["frontier"]["turns"] >= a["frontier"]["turns"]
+        and b["cost_usd"]["total"] > a["cost_usd"]["total"]
+    )
+
+
+#: The three signals, in the fixed order they are reported in. Ordering is
+#: fixed rather than discovery-based so two runs over the same series read the
+#: same.
+_WORSE_SIGNALS = (
+    ("rework", _rework_worsened, _rework_of),
+    ("escalations", _escalations_worsened, _escalations_of),
+    ("turns_flat_cost_up", _turns_flat_cost_up, _turns_cost_of),
+)
+
+
+def detect_worse(scorecards):
+    """Flag the release series as getting worse, by the pathway's definition.
+
+    "Worse" is named in advance so it is recognizable rather than argued about:
+    rework up, escalations up, or frontier turns flat while cost rises -- any
+    one of them for two consecutive releases. Two consecutive *transitions* is
+    the rule, so it takes three scorecards to fire: one bad release is noise,
+    two in a row is a trend.
+
+    Fewer than three is reported as ``insufficient_series`` rather than as a
+    quiet False, because "not enough series to say" and "not worse" are
+    different answers and a caller must not be able to read one as the other.
+    """
+    cards = list(scorecards)
+    if len(cards) < 3:
+        return {"worse": False, "signals": [], "insufficient_series": True}
+
+    signals = []
+    for name, worsened, value_of in _WORSE_SIGNALS:
+        # Oldest window first, consistent with every other ordering here.
+        for i in range(len(cards) - 2):
+            window = cards[i:i + 3]
+            if worsened(window[0], window[1]) and worsened(window[1], window[2]):
+                signals.append({
+                    "signal": name,
+                    "releases": [card["release"] for card in window],
+                    "values": [value_of(card) for card in window],
+                })
+
+    return {
+        "worse": bool(signals),
+        "signals": signals,
+        "insufficient_series": False,
     }
