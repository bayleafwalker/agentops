-    def turns_flat_cost_up_worsened(a, b):
+    def cost_up_without_more_turns_worsened(a, b):
+        """More was spent without more frontier work being done.
+
+        Turns must NOT have risen. Rising turns explain rising spend -- a
+        bigger release did more frontier work -- and a detector that fires
+        there is crying wolf, which is how a signal stops being read.
+
+        Turns *dropping* while the figure rises does fire, and that is the
+        case this signal exists for: dropping frontier turns is the whole
+        programme's goal, so cost climbing anyway means each remaining turn
+        has become dramatically more expensive.
+        """
         return (
-            b["frontier"]["turns"] >= a["frontier"]["turns"]
+            b["frontier"]["turns"] <= a["frontier"]["turns"]
