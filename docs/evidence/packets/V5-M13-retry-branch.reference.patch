+def packet_branch(packet: dict[str, Any]) -> str:
+    """The remote branch this attempt pushes to.
+
+    A first attempt uses the branch the packet declares. A retry gets its own,
+    because attempt 1's branch is already on the remote and a plain push is
+    rejected -- V5-M12 attempt 2 produced a correct diff, passed every gate, and
+    died there. No retry had reached the PR step before, which is why it
+    surfaced only then.
+
+    Force-pushing would be the wrong answer: the earlier branch is the evidence
+    the retry was authored against, and the rejection notice points at it. So
+    the retry moves and the record stays, which is the same shape as the owner's
+    ruling on the attempt counter.
+    """
+    branch = packet["worktree"]["branch"]
+    attempt = packet.get("attempt", 1)
+    if not isinstance(attempt, int) or attempt <= 1:
+        return branch
+    return f"{branch}-attempt-{attempt}"
+
