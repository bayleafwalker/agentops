+def filter_by_project(rows, project):
+    """Keep the sink rows belonging to one project.
+
+    The Stop-hook sink is global: it receives rows from every repo on the
+    machine, so an unscoped release counts whatever else happened to run in
+    the same window.
+
+    Matching is exact. Not a substring, because ``agentops`` would then match
+    ``agentops-web`` and quietly fold another repo's sessions back into the
+    figure this exists to remove; and not case-folded, for the same reason.
+
+    A row that names no project cannot be attributed to one, so it is dropped
+    while scoping -- but kept when ``project`` is None, since nothing is being
+    attributed then.
+    """
+    if project is None:
+        return list(rows)
+    return [row for row in rows if row.get("project") == project
+            and isinstance(row.get("project"), str)]
+
