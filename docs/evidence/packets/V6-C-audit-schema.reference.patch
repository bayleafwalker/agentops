+def audit_schema(schema, path="$"):
+    """Report EVERY construct this checker cannot enforce, raising nothing.
+
+    ``validate`` raises on the first such construct, which is right for a gate
+    and close to useless for a human fixing a schema: one anonymous exception
+    per run. ``manifest.schema.json`` carried the unenforceable subschema form
+    of ``additionalProperties`` in three separate nodes, one of them only
+    reachable through a ``oneOf``, and each run named one and stopped.
+
+    Each entry carries the breadcrumb of the offending node and names the
+    offending keyword. An empty list means the schema is enforceable end to
+    end, which is exactly the condition under which ``validate`` does not
+    raise -- the two answer the same question and must never disagree.
+    """
+    entries = []
+    _audit_entries(schema, path, schema, set(), entries)
+    return entries
+
