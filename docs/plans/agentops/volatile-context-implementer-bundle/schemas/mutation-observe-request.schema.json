{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vuoro.example/schemas/agent-context/mutation-observe-request-v1.json",
  "title": "Post-mutation observation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harness",
    "dispatch_id",
    "session_id",
    "provider_id",
    "tool_name",
    "tool_input"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "harness": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "reference"
      ]
    },
    "dispatch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "resource_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "new_revision": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "tool_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tool_input": {},
    "tool_response": {}
  }
}
