{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vuoro.example/schemas/agent-context/binding-fallback-v1.json",
  "title": "Hand-start session binding fallback v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dispatch_id",
    "repo_id",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "dispatch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "repo_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
