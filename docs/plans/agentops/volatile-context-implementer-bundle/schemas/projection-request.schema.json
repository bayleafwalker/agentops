{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vuoro.example/schemas/agent-context/projection-request-v1.json",
  "title": "Agent context projection request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harness",
    "event",
    "mode",
    "dispatch_id",
    "session_id",
    "cwd"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "harness": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "reference"
      ]
    },
    "event": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "mode": {
      "type": "string",
      "enum": [
        "full",
        "delta"
      ]
    },
    "dispatch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "repo_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "provider_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    }
  }
}
