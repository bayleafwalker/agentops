{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vuoro.dev/schemas/vuoro-cloud-operator-self-use/v1",
  "title": "vuoro.cloud operator-self-use qualification record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "reviewer", "reviewed_on", "pat", "fallback_environment", "vuoro_shared_fallback", "evidence_refs", "cutover_open_rows"],
  "properties": {
    "schema_version": {"const": "vuoro-cloud-operator-self-use/v1"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["environment_id", "workspace_id", "workspaces", "operator_owned", "host_owner"], "properties": {"environment_id": {"const": "vuoro-cloud"}, "workspace_id": {"const": "01M3ABJS1QW0Q6BNDCHP0DDTYF"}, "workspaces": {"type": "array", "items": {"const": "kotona"}, "minItems": 1}, "operator_owned": {"type": "boolean"}, "host_owner": {"type": "string"}}},
    "reviewer": {"type": "string", "minLength": 1}, "reviewed_on": {"type": "string", "format": "date"},
    "pat": {"type": "object", "additionalProperties": false, "required": ["id", "expires_on", "workspace", "authorities"], "properties": {"id": {"type": "string", "minLength": 1}, "expires_on": {"type": "string", "format": "date"}, "workspace": {"const": "kotona"}, "authorities": {"type": "array", "items": {"const": "work:read"}, "minItems": 1, "maxItems": 1}}},
    "fallback_environment": {"const": "vuoro-shared"}, "vuoro_shared_fallback": {"type": "boolean"},
    "evidence_refs": {
      "type": "object",
      "allOf": [
        {"if": {"required": ["restored_observation"]}, "then": {"required": ["restored_observation_sha256"]}},
        {"if": {"required": ["cutover_rehearsal"]}, "then": {"required": ["cutover_rehearsal_sha256"]}}
      ],
      "additionalProperties": false,
      "required": ["profile", "cutover_plan", "cutover_plan_sha256"],
      "properties": {
        "profile": {"const": "environment-record/profiles/workstation-vuoro-cloud.json"},
        "cutover_plan": {"const": "docs/plans/2026-11-08-vuoro-cloud-record-family-cutover.md"},
        "cutover_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "restored_observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cutover_rehearsal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "composition_qualification": {
          "type": "object",
          "required": ["ref", "pinned_pair", "sha256"],
          "properties": {
            "ref": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "pinned_pair": {
              "type": "object",
              "required": ["tenant_runtime_pin", "sprintctl_version"],
              "properties": {
                "tenant_runtime_pin": {"type": "string"},
                "sprintctl_version": {"type": "string"}
              }
            }
          }
        }
        ,"restored_observation": {"type": "string", "minLength": 1}
        ,"cutover_rehearsal": {"type": "string", "minLength": 1}
      }
    },
    "cutover_open_rows": {"type": "array", "items": {"type": "string"}},
    "latest_restored_observation": {"type": "object"},
    "rehearsal_on": {"type": "string", "format": "date"}, "pat_reissued": {"type": "boolean"}, "revoked": {"type": "boolean"},
    "tenant_runtime_pin_changed_after_composition": {"type": "boolean"},
    "no_restored_observation_since": {"type": "string", "format": "date"}
  }
}
