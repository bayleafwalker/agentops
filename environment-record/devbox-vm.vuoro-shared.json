{
  "schema_version": "environment-record/v1",
  "id": "devbox",
  "environment_class": "local",
  "revision": 4,
  "roles": ["unattended-agent-host", "vuoro-served-client"],
  "constraints": [
    "no-direct-postgresql-egress-for-sprintctl",
    "profile-target-must-be-vuoro-shared",
    "production-endpoint-required",
    "independent-worktree-and-tool-install"
  ],
  "capabilities": ["git-worktree", "vuoro-served-work-client"],
  "runbook_refs": [
    "/projects/dev/agentops/docs/runbooks/vuoro-workstation-cutover.md#devbox-vm",
    "/projects/dev/agentops/docs/runbooks/vuoro-workstation-cutover.md#identity-and-production-boundary",
    "/projects/dev/agentops/docs/architecture/bounded-execution-environment.md"
  ],
  "identity_bindings": [
    {"principal": "environment:devbox-agent", "roles": ["vuoro-shared-work-client"]}
  ],
  "authority": {
    "standing_read": {
      "operations": [
        "work.run.resolve-v1",
        "work.run.predecessor-context-v1",
        "work.effect.attempt-get-v1",
        "work.agent.list-v1",
        "work.agent.describe-v1",
        "work.message.status-v1",
        "work.read.item-decisions"
      ]
    },
    "scoped_execution": {
      "repositories": ["agentops"],
      "operations": [
        "work.effect.attempt-open-v1",
        "work.effect.attempt-redeem-v1",
        "work.effect.attempt-seal-unused-v1",
        "work.effect.attempt-report-applied-v1",
        "agentops.dispatch.publish-v1",
        "agentops.host-adapter.launch-successor-v1"
      ],
      "publication_operation": "agentops.dispatch.publish-v1",
      "max_ttl_seconds": 3600
    },
    "explicit_approval": [
      {
        "transition": "rollout-resume",
        "operations": ["rollout.resume-*"],
        "approvers": ["workstation-vuoro"],
        "max_approval_age_seconds": 3600
      },
      {
        "transition": "protected-publication",
        "operations": ["agentops.publication.protected-*", "pr.merge"],
        "approvers": ["workstation-vuoro"],
        "max_approval_age_seconds": 3600
      }
    ]
  },
  "tooling": [
    {
      "name": "sprintctl",
      "version": "0.19.0",
      "source": "/nix/store/jb2gza1m5m77rvi26nwf55ga9agjrpm1-sprintctl-0.19.0 (gitops-nixos pkgs/sprintctl.nix: bayleafwalker/sprintctl v0.19.0 ad66ddd, extras remote,served)",
      "digest": "nix:jb2gza1m5m77rvi26nwf55ga9agjrpm1"
    },
    {
      "name": "vuoro-client",
      "version": "0.1.1",
      "source": "gitops-nixos pkgs/agentops-host-adapter.nix: bayleafwalker/vuoro 8b8428e, packages/vuoro-client",
      "digest": "git:8b8428e41c2178d1ae573cfb15917acdc9f05652"
    },
    {
      "name": "vuoro-adapter-kit",
      "version": "0.2.2",
      "source": "gitops-nixos pkgs/sprintctl.nix: release wheel vuoro_adapter_kit-0.2.2-py3-none-any.whl",
      "digest": "sha256:6d78c2f05a8e3a72c480b0e333232bc90ccee1a36b71fba09f5bc8fc8e5377fa"
    },
    {
      "name": "opencode",
      "version": "1.19.0",
      "source": "/nix/store/0j2gmj4zx6xac1iipzy9m3ybh6wwkh6p-opencode-1.19.0",
      "digest": "nix:0j2gmj4zx6xac1iipzy9m3ybh6wwkh6p"
    },
    {
      "name": "uv",
      "version": "0.13.0",
      "source": "/nix/store/373m9zapp9af30wim3d9i553fxyap7qz-uv-0.13.0",
      "digest": "nix:373m9zapp9af30wim3d9i553fxyap7qz"
    },
    {
      "name": "nixpkgs",
      "version": "26.11.20261011.7fd4004 (nixos-unstable)",
      "source": "gitops-nixos flake.lock nixpkgs input; the devbox toplevel is pinned by the gitops-nixos commit that deploys this record, not here (a record cannot pin a system closure that contains the record)",
      "digest": "git:7fd4004d0511991fff3a0524856a9be09e28c5f0"
    }
  ],
  "trust_roots": [
    {
      "id": "system-ca-bundle",
      "kind": "tls-ca-bundle",
      "ref": "/etc/ssl/certs/ca-certificates.crt",
      "digest": "sha256:3ba2000fe3d55cb6c41323fabbb105743e2c9422151eea213311538b07b23f5a"
    },
    {
      "id": "vuoro-shared",
      "kind": "vuoro-endpoint",
      "ref": "https://vuoro-shared.apps.kotona.app"
    },
    {
      "id": "cred-broker",
      "kind": "credential-broker",
      "ref": "appservice clusters/main/kubernetes/apps/cred-broker (host profile development-bounded)"
    }
  ],
  "credential_broker": {
    "host_profile": "development-bounded",
    "subject": "usr_agent_devbox",
    "capabilities": [
      {"capability": "repo.read", "target": "repo_agentops_github", "bound": false},
      {"capability": "repo.write", "target": "repo_agentops_github", "bound": false},
      {"capability": "pr.manage", "target": "repo_agentops_github", "bound": false}
    ]
  }
}
