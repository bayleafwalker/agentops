{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vuoro.dev/schemas/environment-record/v1",
  "title": "Vuoro environment record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "environment_class",
    "revision",
    "roles",
    "constraints",
    "capabilities",
    "runbook_refs",
    "identity_bindings"
  ],
  "allOf": [
    {
      "if": {
        "required": ["roles"],
        "properties": { "roles": { "not": { "items": { "not": { "const": "unattended-agent-host" } } } } }
      },
      "then": { "required": ["authority", "tooling"] }
    }
  ],
  "properties": {
    "schema_version": { "const": "environment-record/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "environment_class": {
      "enum": ["local", "development", "production", "recovery"]
    },
    "revision": { "type": "integer", "minimum": 1 },
    "roles": {
      "type": "array",
      "items": { "$ref": "#/$defs/token" },
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/token" },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/token" },
      "uniqueItems": true
    },
    "runbook_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "holds": {
      "description": "Declared pauses of this environment (e.g. an agent host taken out of dispatch). An empty array states that nothing is held; an absent field means holds are not modelled, which `agentops estate status` reports as unknown.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "$ref": "#/$defs/token" },
          "reason": { "type": "string", "minLength": 1 },
          "since": { "type": "string", "minLength": 1, "format": "date-time" },
          "ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "identity_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principal", "roles"],
        "properties": {
          "principal": { "type": "string", "minLength": 1 },
          "roles": {
            "type": "array",
            "items": { "$ref": "#/$defs/token" },
            "uniqueItems": true
          }
        }
      }
    },
    "authority": {
      "description": "Bounded authority of this execution environment, checked at the effect boundary by scripts/execution_authority.py before any effect is dispatched. A record without this block grants no execution authority.",
      "type": "object",
      "additionalProperties": false,
      "required": ["standing_read", "scoped_execution", "explicit_approval"],
      "properties": {
        "standing_read": {
          "description": "Tier 1: read-only diagnosis operations, always allowed.",
          "type": "object",
          "additionalProperties": false,
          "required": ["operations"],
          "properties": { "operations": { "$ref": "#/$defs/operations" } }
        },
        "scoped_execution": {
          "description": "Tier 2: listed operations on listed repositories, inside a live run bound to the request's grant, within max_ttl_seconds.",
          "type": "object",
          "additionalProperties": false,
          "required": ["repositories", "operations", "publication_operation", "max_ttl_seconds"],
          "properties": {
            "repositories": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/token" }
            },
            "operations": { "$ref": "#/$defs/operations" },
            "publication_operation": {
              "$ref": "#/$defs/operation",
              "description": "The one named publication operation; must also be listed in operations."
            },
            "max_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
          }
        },
        "explicit_approval": {
          "description": "Tier 3: consequential transitions refused without a served approval decision by a listed approver, bound to transition, repository and run, younger than max_approval_age_seconds.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transition", "operations", "approvers", "max_approval_age_seconds"],
            "properties": {
              "transition": { "$ref": "#/$defs/token" },
              "operations": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/operation_pattern" }
              },
              "approvers": {
                "description": "Vuoro identity actors whose work.decision.record accept decisions count as approval.",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" }
              },
              "max_approval_age_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
            }
          }
        }
      }
    },
    "tooling": {
      "description": "Pinned runner composition. The record revision is the runner release version.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "source", "digest"],
        "properties": {
          "name": { "$ref": "#/$defs/token" },
          "version": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "digest": {
            "type": "string",
            "pattern": "^(sha256:[0-9a-f]{64}|git:[0-9a-f]{40}|nix:[0-9a-z]{32})$"
          }
        }
      }
    },
    "trust_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "ref"],
        "properties": {
          "id": { "$ref": "#/$defs/token" },
          "kind": { "enum": ["tls-ca-bundle", "vuoro-endpoint", "credential-broker"] },
          "ref": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "credential_broker": {
      "description": "Credential broker binding. Capability IDs are cred-broker's Capability enum (cred-broker src/cred_broker/models.py).",
      "type": "object",
      "additionalProperties": false,
      "required": ["host_profile", "subject", "capabilities"],
      "properties": {
        "host_profile": { "$ref": "#/$defs/token" },
        "subject": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "target", "bound"],
            "properties": {
              "capability": {
                "enum": [
                  "repo.read", "repo.write", "repo.create", "repo.admin", "repo.delete",
                  "pr.read", "pr.manage", "pr.merge", "release.read", "release.publish",
                  "deploy.read", "deploy.nonprod", "deploy.prod", "kubernetes.edit"
                ]
              },
              "target": { "type": "string", "minLength": 1 },
              "bound": {
                "type": "boolean",
                "description": "Whether broker policy binds this capability for this subject today; false records a known gap."
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "operation": {
      "description": "One exact operation ID. Grants (standing_read, scoped_execution) never use wildcards.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "operation_pattern": {
      "description": "An operation ID, or a prefix with one trailing '*'. Only explicit_approval (which restricts) may use it.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*\\*?$"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operation" }
    }
  }
}
