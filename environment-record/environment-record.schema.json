{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vuoro.dev/schemas/environment-record/v1",
  "title": "Vuoro environment record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "environment_class",
    "revision",
    "roles",
    "constraints",
    "capabilities",
    "runbook_refs",
    "identity_bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "environment-record/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "environment_class": {
      "enum": [
        "local",
        "development",
        "production",
        "recovery"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      },
      "uniqueItems": true
    },
    "runbook_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "identity_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principal",
          "roles"
        ],
        "properties": {
          "principal": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/token"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "authority": {
      "description": "Bounded authority of this execution environment, checked at the effect boundary by scripts/execution_authority.py before any effect is dispatched. A record without this block grants no execution authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standing_read",
        "scoped_execution",
        "explicit_approval"
      ],
      "properties": {
        "standing_read": {
          "description": "Tier 1: read-only diagnosis operations, always allowed.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operations"
          ],
          "properties": {
            "operations": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/operation"
              }
            }
          }
        },
        "scoped_execution": {
          "description": "Tier 2: operations allowed only for listed repositories, inside a live unsuperseded run, within max_ttl_seconds of the grant.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repositories",
            "operations",
            "publication_operation",
            "max_ttl_seconds"
          ],
          "properties": {
            "repositories": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/token"
              }
            },
            "operations": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/operation"
              }
            },
            "publication_operation": {
              "$ref": "#/$defs/operation",
              "description": "The one named publication operation; must be matched by operations."
            },
            "max_ttl_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          }
        },
        "explicit_approval": {
          "description": "Tier 3: consequential transitions that always require an operator approval reference.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "transition",
              "operations"
            ],
            "properties": {
              "transition": {
                "$ref": "#/$defs/token"
              },
              "operations": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/operation"
                }
              }
            }
          }
        }
      }
    },
    "tooling": {
      "description": "Pinned runner composition. The record revision is the runner release version.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "source",
          "digest"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/token"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^(sha256:[0-9a-f]{64}|git:[0-9a-f]{40}|nix:[0-9a-z]{32})$"
          }
        }
      }
    },
    "trust_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "ref"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/token"
          },
          "kind": {
            "enum": [
              "tls-ca-bundle",
              "vuoro-endpoint",
              "credential-broker"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "credential_broker": {
      "description": "Credential broker binding. Capability IDs are cred-broker's Capability enum (cred-broker src/cred_broker/models.py).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_profile",
        "subject",
        "capabilities"
      ],
      "properties": {
        "host_profile": {
          "$ref": "#/$defs/token"
        },
        "subject": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability",
              "target",
              "bound"
            ],
            "properties": {
              "capability": {
                "enum": [
                  "repo.read",
                  "repo.write",
                  "repo.create",
                  "repo.admin",
                  "repo.delete",
                  "pr.read",
                  "pr.manage",
                  "pr.merge",
                  "release.read",
                  "release.publish",
                  "deploy.read",
                  "deploy.nonprod",
                  "deploy.prod",
                  "kubernetes.edit"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "bound": {
                "type": "boolean",
                "description": "Whether broker policy binds this capability for this subject today; false records a known gap."
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*\\*?$",
      "description": "An operation ID; one trailing '*' matches any suffix (e.g. work.effect.attempt-*)."
    }
  }
}
