{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vuoro.dev/schemas/vuoro-cloud-held-workspaces/v1",
  "title": "vuoro-cloud held-by-design workspace allowlist v1",
  "description": "Reviewed list of vuoro-cloud workspaces that stay in maintenance by design. Scope: the agentops estate report's `holds` gate only (scripts/estate_status.py). It does not affect vuoro-cloud's own rollout or fleet-convergence gates. An entry exempts a served maintenance hold only while the served fields match its expectation; see docs/runbooks/estate-status.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment_id", "scope", "entries"],
  "properties": {
    "schema_version": { "const": "vuoro-cloud-held-workspaces/v1" },
    "environment_id": { "const": "vuoro-cloud" },
    "scope": { "type": "string", "minLength": 1 },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "slug",
        "reason",
        "reviewer",
        "reviewed_on",
        "expected_state",
        "expected_maintenance_mode",
        "expected_read_only",
        "retire_blocked_by"
      ],
      "properties": {
        "workspace_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
        "slug": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewed_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "expected_state": { "type": "string", "minLength": 1 },
        "expected_maintenance_mode": { "const": true },
        "expected_read_only": { "type": "boolean" },
        "retire_blocked_by": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "note": { "type": "string" }
      }
    }
  }
}
