#!/usr/bin/env bash
# Thin `agentops <topic> ...` front end over scripts/<topic>.py.
#
# agentops has no packaged CLI: every capability is a standalone argparse script
# invoked by path. The context-economy plan spells the handoff commands
# `agentops handoff create|validate|prompt|ack`, and a successor prompt that names a
# path to a script inside a repository it has not read yet is worse than one that
# names a command. This supplies the spelling without inventing a packaging story: it
# resolves the topic to a script and execs it, so `--help`, exit codes and stdio are
# the script's own.
#
# All scripts live in scripts/. templates/dispatch was deleted in S2 item 6.
#
# Put this directory on PATH (or symlink this file into ~/.local/bin).
set -euo pipefail

self="${BASH_SOURCE[0]}"
if [[ -L "$self" ]] && command -v readlink >/dev/null 2>&1; then
  self="$(readlink -f -- "$self")"
fi
root="$(cd -- "$(dirname -- "$self")/.." && pwd)"

PY=""
for candidate in python3 /usr/bin/python3 "$HOME/.local/bin/python3"; do
  if command -v "$candidate" >/dev/null 2>&1; then PY="$candidate"; break; fi
done
if [[ -z "$PY" ]]; then
  printf 'agentops: no python3 on PATH\n' >&2
  exit 127
fi
front() { exec "$PY" "$root/scripts/agentops_front.py" "$@"; }

# Front door: help is a map (stdout, exit 0); `help <topic>` is `<topic> --help`.
if [[ $# -lt 1 ]]; then front help; fi
case "$1" in
  -h|--help) front help ;;
  --version|-V|version) front version ;;
  topics) shift; front topics "$@" ;;
  help) shift; if [[ $# -lt 1 ]]; then front help; fi; set -- "$@" --help ;;
esac

topic="$1"; shift
script=""
prog="agentops ${topic//_/-}"
families="estate dispatch"  # `agentops <family> <word>` selects scripts/<family>_<word>.py
dir="$root/scripts"
if [[ ! "$topic" =~ ^[A-Za-z0-9_-]+$ ]]; then
  front unknown "$topic"
elif [[ "$topic" != agentops_front && "$topic" != agentops-front && -r "$dir/${topic//-/_}.py" ]]; then
  script="$dir/${topic//-/_}.py"
elif [[ " $families " == *" $topic "* ]]; then
  word="${1:-}"
  if [[ -z "$word" || "$word" == -h || "$word" == --help || "$word" == help ]]; then front group "$topic"; fi
  if [[ "$word" =~ ^[A-Za-z0-9_-]+$ && -r "$dir/${topic}_${word//-/_}.py" ]]; then
    script="$dir/${topic}_${word//-/_}.py"
    prog="agentops $topic ${word//_/-}"
    # estate_status.py receives `status ...` so its own usage line can spell the two-word
    # form; every other family script receives only its arguments.
    if [[ "$topic" != estate ]]; then shift; fi
  else
    front unknown "$topic" "$word"
  fi
fi
if [[ -z "$script" ]]; then
  front unknown "$topic"
fi

# This transport topic needs its released client; use its committed script
# lock without discovering a caller's unrelated project configuration.
if [[ "$script" == "$root/scripts/operator_requests.py" || "$script" == "$root/scripts/repository_delivery.py" ]]; then
  if ! command -v uv >/dev/null 2>&1; then
    printf 'agentops: uv is required for the locked client runtime\n' >&2
    exit 127
  fi
  exec uv run --no-config --no-project --locked --script "$script" "$@"
fi

# Run the script with argv[0] set to the canonical spelling, so argparse usage lines
# read `agentops estate status ...` instead of `estate_status.py ...`. The script
# directory goes on sys.path as it would when run by path; the cwd does not.
exec "$PY" -c 'import runpy, sys
script, sys.argv = sys.argv[1], sys.argv[2:]
sys.path[:] = [script.rsplit("/", 1)[0]] + [p for p in sys.path if p]
runpy.run_path(script, run_name="__main__")' "$script" "$prog" "$@"
