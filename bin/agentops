#!/usr/bin/env bash
# Thin `agentops <topic> ...` front end over scripts/<topic>.py.
#
# agentops has no packaged CLI: every capability is a standalone argparse script
# invoked by path. The context-economy plan spells the handoff commands
# `agentops handoff create|validate|prompt|ack`, and a successor prompt that names a
# path to a script inside a repository it has not read yet is worse than one that
# names a command. This supplies the spelling without inventing a packaging story: it
# resolves the topic to a script and execs it, so `--help`, exit codes and stdio are
# the script's own.
#
# All scripts live in scripts/. templates/dispatch was deleted in S2 item 6.
#
# Put this directory on PATH (or symlink this file into ~/.local/bin).
set -euo pipefail

self="${BASH_SOURCE[0]}"
if [[ -L "$self" ]] && command -v readlink >/dev/null 2>&1; then
  self="$(readlink -f -- "$self")"
fi
root="$(cd -- "$(dirname -- "$self")/.." && pwd)"

if [[ $# -lt 1 ]]; then
  printf 'usage: agentops <topic> [args...]\n\ntopics:\n' >&2
  for s in "$root"/scripts/*.py; do
    if [[ -r "$s" ]]; then basename "${s%.py}" | tr '_' '-'; fi
  done | sort -u | sed 's/^/  /' >&2
  exit 2
fi

topic="$1"; shift
script=""
two_word_topics="estate"  # topics whose second word selects scripts/<topic>_<word>.py
dir="$root/scripts"
if [[ -r "$dir/${topic//-/_}.py" ]]; then
  script="$dir/${topic//-/_}.py"
elif [[ $# -ge 1 && " $two_word_topics " == *" $topic "* && "$1" =~ ^[a-z]+$ \
        && -r "$dir/${topic}_${1}.py" ]]; then
  # Two-word topics, allowlisted: `agentops estate status` -> scripts/estate_status.py,
  # which receives `status ...` so its own usage line can spell the two-word form.
  script="$dir/${topic}_${1}.py"
fi
if [[ -z "$script" ]]; then
  printf 'agentops: no such topic %q (looked in %s/scripts)\n' "$topic" "$root" >&2
  exit 2
fi

# This transport topic needs its released client; use its committed script
# lock without discovering a caller's unrelated project configuration.
if [[ "$script" == "$root/scripts/operator_requests.py" ]]; then
  if ! command -v uv >/dev/null 2>&1; then
    printf 'agentops operator-requests: uv is required for the locked client runtime\n' >&2
    exit 127
  fi
  exec uv run --no-config --no-project --locked --script "$script" "$@"
fi

PY=""
for candidate in python3 /usr/bin/python3 "$HOME/.local/bin/python3"; do
  if command -v "$candidate" >/dev/null 2>&1; then PY="$candidate"; break; fi
done
if [[ -z "$PY" ]]; then
  printf 'agentops: no python3 on PATH\n' >&2
  exit 127
fi

exec "$PY" "$script" "$@"
