{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/test-context.schema.json",
  "title": "State protocol test context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "owner_repo",
    "subject",
    "contract_ref",
    "source_of_truth",
    "depth",
    "backends",
    "actors",
    "initial_state",
    "operations",
    "consistency",
    "invariants",
    "faults",
    "oracles",
    "implementation_anchors"
  ],
  "properties": {
    "schema_version": { "const": "test-context/v1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "owner_repo": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "subject": { "type": "string", "minLength": 1 },
    "contract_ref": { "$ref": "#/$defs/contractRef" },
    "source_of_truth": { "type": "string", "minLength": 1 },
    "depth": { "type": "integer", "minimum": 0, "maximum": 3 },
    "backends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "initial_state": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "object"],
      "properties": {
        "target": {
          "enum": ["linearizable", "serializable", "strict-serializable", "application-invariant", "projection-convergence", "documented-only"]
        },
        "object": { "type": "string", "minLength": 1 }
      }
    },
    "assumptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isolation": { "type": "string" },
        "clock": { "type": "string" },
        "fairness": { "type": "string" }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": { "type": ["integer", "string", "boolean"] }
    },
    "invariants": { "$ref": "#/$defs/nonEmptyStrings" },
    "faults": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "oracles": { "$ref": "#/$defs/nonEmptyStrings" },
    "implementation_anchors": { "$ref": "#/$defs/nonEmptyStrings" },
    "expansions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["semantic-doc", "stateful-test", "concurrent-history", "formal-model-config", "fault-scenario"]
      }
    }
  },
  "$defs": {
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_id", "revision"],
      "properties": {
        "doc_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "actors"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "actors": {
          "oneOf": [
            { "const": "*" },
            { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "synchronization": { "type": "string" },
        "parameters": { "type": "object" }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
