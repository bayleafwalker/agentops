{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/portable-manual-launch-observation.v1.schema.json",
  "title": "Portable manual launch observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "phase",
    "observed_at",
    "operator_id",
    "provider_id",
    "platform_task_id",
    "resolved_model",
    "environment",
    "source_refs",
    "evidence_sha256",
    "claim_status"
  ],
  "properties": {
    "schema": { "const": "portable-manual-launch-observation/v1" },
    "receipt_id": { "$ref": "#/$defs/identifier" },
    "phase": { "enum": ["intent", "submitted", "acknowledged", "started", "useful_progress"] },
    "observed_at": { "type": "string", "format": "date-time", "maxLength": 80 },
    "operator_id": { "$ref": "#/$defs/identifier" },
    "provider_id": { "$ref": "#/$defs/nullableText" },
    "platform_task_id": { "$ref": "#/$defs/nullableText" },
    "resolved_model": { "$ref": "#/$defs/nullableText" },
    "environment": { "$ref": "#/$defs/nullableText" },
    "source_refs": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "evidence_sha256": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "claim_status": { "enum": ["unknown", "observed-unverified"] }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "enum": ["submitted", "acknowledged", "started", "useful_progress"] } } },
      "then": {
        "properties": {
          "provider_id": { "$ref": "#/$defs/nonEmptyText" },
          "platform_task_id": { "$ref": "#/$defs/nonEmptyText" },
          "resolved_model": { "$ref": "#/$defs/nonEmptyText" },
          "environment": { "$ref": "#/$defs/nonEmptyText" },
          "source_refs": { "type": "array", "minItems": 1, "maxItems": 32 }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonEmptyText": { "type": "string", "minLength": 1, "maxLength": 256 },
    "nullableText": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/nonEmptyText" }
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "branch", "commit"],
      "properties": {
        "repository_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
          "maxLength": 512
        },
        "branch": { "type": "string", "minLength": 1, "maxLength": 240 },
        "commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
      }
    }
  }
}
