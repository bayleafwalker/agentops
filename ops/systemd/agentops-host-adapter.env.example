# Copy to ~/.config/agentops/host-adapter.env (mode 0600). Read by agentops-host-adapter.service.

# vuoro client profile for the adapter's principal: the commissioned inbox identity
# (agentops environment-record/profiles/devbox-inbox-native-vuoro-shared.json, work:read + work:evidence).
AGENTOPS_HOST_ADAPTER_PROFILE=/home/agent/.config/vuoro/profiles/devbox-inbox-native-vuoro-shared.json

# Policy file, re-read every poll and again immediately before each launch. Missing or
# malformed means deny everything. See the schema in scripts/host_adapter.py (load_policy).
AGENTOPS_HOST_ADAPTER_POLICY=/home/agent/.config/agentops/host-adapter/policy.json

# SQLite state (instance_id, read cursor, processing records). One adapter per directory.
AGENTOPS_HOST_ADAPTER_STATE_DIR=/home/agent/.local/state/agentops/host-adapter

# opencode serve on loopback (non-loopback URLs are refused) and the directory sessions run in.
OPENCODE_SERVE_URL=http://127.0.0.1:4096
AGENTOPS_HOST_ADAPTER_DIRECTORY=/projects/dev/agentops

AGENTOPS_HOST_ADAPTER_POLL_SECONDS=30
AGENTOPS_HOST_ADAPTER_HOST_CLASS=devbox

# policy.json example:
# {"enabled": true, "launches_enabled": false,
#  "allowed_senders": ["<sender principal_id>"], "allowed_repos": ["agentops"],
#  "kinds": ["continue"], "max_concurrent": 1, "max_run_seconds": 3600,
#  "harness": {"harness_id": "opencode", "harness_build": "1.18.33", "model_id": "<provider>/<model>",   # provider/ required
#              "recipe_id": "inbox-continue-v1", "observed_profile": {...}}}

# Operator note: `agentops host-adapter resolve <message_id> --abandon` needs the same state lock as the
# service. Stop the service first (systemctl --user stop agentops-host-adapter), resolve, then start it.
# While the service runs, resolve exits 3. `status` is read-only and works at any time.

# The inbox opencode server's password lives in its own file, read by both units:
#   ~/.config/agentops/opencode-inbox-server.env  (mode 0600)
#   OPENCODE_SERVER_PASSWORD=<random, e.g. python3 -c 'import secrets;print(secrets.token_urlsafe(32))'>
# Generate it on the host; never print or commit it.
