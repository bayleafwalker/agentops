[Unit]
Description=agentops host adapter: Vuoro agent inbox to opencode serve (M2b)
Documentation=file:///projects/dev/agentops/scripts/host_adapter.py
After=network-online.target opencode-serve-inbox.service
Wants=opencode-serve-inbox.service

# systemd USER unit (install under ~/.config/systemd/user/). Not enabled by the repo:
# the operator installs it after the policy file and env file exist. One adapter per
# state dir is enforced by a file lock, so a second start exits with status 3.

[Service]
Type=simple
WorkingDirectory=/projects/dev/agentops
EnvironmentFile=%h/.config/agentops/host-adapter.env
# The inbox server's basic-auth password (shared with opencode-serve-inbox.service).
EnvironmentFile=%h/.config/agentops/opencode-inbox-server.env
# Explicit served-mode selection; no direnv. The profile matches AGENTOPS_HOST_ADAPTER_PROFILE.
Environment=SPRINTCTL_BACKEND=served
Environment=SPRINTCTL_VUORO_PROFILE=%h/.config/vuoro/profiles/devbox-inbox-native-vuoro-shared.json
# The sprintctl tool environment carries vuoro_client; the system python3 behind bin/agentops does not.
ExecStart=%h/.local/share/uv/tools/sprintctl/bin/python -I /projects/dev/agentops/scripts/host_adapter.py run
Restart=on-failure
RestartSec=15
# Exit status 3 (state dir locked) and 2 (missing profile) are configuration errors.
RestartPreventExitStatus=2 3
NoNewPrivileges=true

[Install]
WantedBy=default.target
