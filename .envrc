# sprintctl runs in served mode against the Vuoro work adapter (sprintctl
# #1195/#1223/#1226, this repo backfilled into vuoro-shared 2026-07-24 --
# see sprintctl docs/plans/1164-gate-evidence-ledger.md). Normal development
# uses only the non-secret served profile; database recovery is deployment-owner
# work and is intentionally not encoded in this environment file.

export SPRINTCTL_BACKEND=served
export SPRINTCTL_VUORO_PROFILE=/projects/dev/agentops/templates/dispatch/environment-record/profiles/workstation-vuoro-shared.json
unset SPRINTCTL_URL
export SPRINTCTL_DB="$PWD/.sprintctl/sprintctl.db"

# Evidence is rooted at this repository, not at the workspace. Shards and
# metanarrative model records land under ./_artifacts/<scope>/ and are committed,
# so git replicates them wherever it replicates the code they describe. See
# docs/plans/agentops/operative-position-durability-2026-08-29.md; the
# append-only guard is templates/dispatch/scripts/check_append_only_shards.py.
export AUDITCTL_ARTIFACTS_ROOT="$PWD"
export AUDITCTL_DB="$PWD/.auditctl/auditctl.db"

# Host-specific overrides (e.g. a different SPRINTCTL_VUORO_PROFILE on
# devbox-agent) belong in .envrc.local, which is gitignored and never
# committed. It is sourced last so it can override any export above.
source_env_if_exists .envrc.local
