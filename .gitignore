.DS_Store
.env
.env.*
!.env.example
# .envrc is the repository's executable environment contract and is tracked:
# it declares the served backend, the vuoro profile and the artifacts root, and
# leaving it untracked is why those had to be re-created by hand on every host.
# Host-specific overrides belong in .envrc.local, which stays ignored.
.envrc.local
node_modules/
dist/
build/
.next/
coverage/
apps/node_modules.bad*/
__pycache__/
*.py[cod]
.envrc.local
.envrc.*
!.envrc.example
.sprintctl/
.auditctl/
ops/systemd/session-mechanization-projects.conf

# Reference patches are the coordinator's own solution to a frozen packet. They are
# ignored so a worker's worktree can never pick one up by accident, and committed
# deliberately with `git add -f` as part of commit 2 of a freeze. This rule lived in
# .git/info/exclude until 2026-08-26, which made it clone-local: the handover's
# "reference patches are gitignored -- git add -f them" was true on one machine and
# false on a fresh clone, with no way for a reader to tell which case they were in.
docs/evidence/packets/*.reference.patch

# Evidence for scopes this repository does not own. AUDITCTL_ARTIFACTS_ROOT follows
# the session's working directory, so a publisher writing a different scope -- the
# Stop hook writes `dev` -- lands it here. Those scopes have no repository to be
# rooted at (see docs/plans/agentops/operative-position-durability-2026-08-29.md §6),
# and agentops is not their home. Only _artifacts/agentops/ is tracked.
/_artifacts/*
!/_artifacts/agentops/
# Jev score/replay output: derived from recorded decisions or a corpus, reproducible.
# Recorded routing decisions are durable as dispatch.route.decision events.
/_artifacts/agentops/jev-shadow/
# auditctl NDJSON shards the hooks write here. Since 2026-09-30 no job commits them:
# gitops-nixos audit-shards-collect copies them out of every checkout (by file glob,
# not through Git) and audit-shards-publish replicates them to the private
# bayleaf/audit-archive repository, the successor evidence home (gitops-nixos
# docs/runbooks/audit-persistence.md). Shards committed before that stay tracked as
# append-only history (TS-6); this rule only hides new, untracked shards.
/_artifacts/agentops/audit/
.claude/settings.local.json

# Private frozen replay inputs; public evidence contains their hash and source recipe.
/jev/eval/agentops-2026-10-20/cases.jsonl
